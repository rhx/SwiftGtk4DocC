{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchPos"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matchNum"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"startPos"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gint","preciseIdentifier":"c:@T@gint"},{"kind":"text","text":">! = nil, "},{"kind":"externalParam","text":"endPos"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gint","preciseIdentifier":"c:@T@gint"},{"kind":"text","text":">! = nil) -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Valid values for "},{"type":"codeVoice","code":"matchNum"},{"type":"text","text":" are "},{"type":"codeVoice","code":"0"},{"type":"text","text":" for the full text of the match,"},{"type":"text","text":" "},{"type":"codeVoice","code":"1"},{"type":"text","text":" for the first paren set, "},{"type":"codeVoice","code":"2"},{"type":"text","text":" for the second, and so on."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As "},{"type":"codeVoice","code":"endPos"},{"type":"text","text":" is set to the byte after the final byte of the match (on success),"},{"type":"text","text":" "},{"type":"text","text":"the length of the match can be calculated as "},{"type":"codeVoice","code":"end_pos - start_pos"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"As a best practice, initialize "},{"type":"codeVoice","code":"startPos"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endPos"},{"type":"text","text":" to identifiable"},{"type":"text","text":" "},{"type":"text","text":"values, such as "},{"type":"codeVoice","code":"G_MAXINT"},{"type":"text","text":", so that you can test if"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"type":"text","text":" actually changed the value for a given"},{"type":"text","text":" "},{"type":"text","text":"capture parenthesis."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parameter "},{"type":"codeVoice","code":"matchNum"},{"type":"text","text":" corresponds to a matched capture parenthesis. The"},{"type":"text","text":" "},{"type":"text","text":"actual value you use for "},{"type":"codeVoice","code":"matchNum"},{"type":"text","text":" depends on the method used to generate"},{"type":"text","text":" "},{"type":"codeVoice","code":"matchInfo"},{"type":"text","text":". The following sections describe those methods."}]},{"anchor":"Methods-Using-Non-deterministic-Finite-Automata-Matching","level":2,"type":"heading","text":"Methods Using Non-deterministic Finite Automata Matching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The methods [method"},{"type":"codeVoice","code":"GLib.Regex.match"},{"type":"text","text":"] and [method"},{"type":"codeVoice","code":"GLib.Regex.match_full"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"return a [struct"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfo"},{"type":"text","text":"] using traditional (greedy) pattern"},{"type":"text","text":" "},{"type":"text","text":"matching, also known as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Nondeterministic_finite_automaton"},{"type":"text","text":" "},{"type":"text","text":"(NFA) matching. You pass the returned "},{"type":"codeVoice","code":"GMatchInfo"},{"type":"text","text":" from these methods to"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"type":"text","text":" to determine the start and end positions"},{"type":"text","text":" "},{"type":"text","text":"of capture parentheses. The values for "},{"type":"codeVoice","code":"matchNum"},{"type":"text","text":" correspond to the capture"},{"type":"text","text":" "},{"type":"text","text":"parentheses in order, with "},{"type":"codeVoice","code":"0"},{"type":"text","text":" corresponding to the entire matched string."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"matchNum"},{"type":"text","text":" can refer to a capture parenthesis with no match. For example,"},{"type":"text","text":" "},{"type":"text","text":"the string "},{"type":"codeVoice","code":"b"},{"type":"text","text":" matches against the pattern "},{"type":"codeVoice","code":"(a)?b"},{"type":"text","text":", but the capture"},{"type":"text","text":" "},{"type":"text","text":"parenthesis "},{"type":"codeVoice","code":"(a)"},{"type":"text","text":" has no match. In this case, "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"type":"text","text":" "},{"type":"text","text":"returns true and sets "},{"type":"codeVoice","code":"startPos"},{"type":"text","text":" and "},{"type":"codeVoice","code":"endPos"},{"type":"text","text":" to "},{"type":"codeVoice","code":"-1"},{"type":"text","text":" when called with"},{"type":"text","text":" "},{"type":"codeVoice","code":"match_num"},{"type":"text","text":" as "},{"type":"codeVoice","code":"1"},{"type":"text","text":" (for "},{"type":"codeVoice","code":"(a)"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an expanded example, a regex pattern is "},{"type":"codeVoice","code":"(a)?(.*?)the (.*)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and a candidate string is "},{"type":"codeVoice","code":"glib regexes are the best"},{"type":"text","text":". In this scenario"},{"type":"text","text":" "},{"type":"text","text":"there are four capture parentheses numbered 0–3: an implicit one"},{"type":"text","text":" "},{"type":"text","text":"for the entire string, and three explicitly declared in the regex pattern."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given this example, the following table describes the return values"},{"type":"text","text":" "},{"type":"text","text":"from "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"type":"text","text":" for various values of "},{"type":"codeVoice","code":"matchNum"},{"type":"text","text":"."}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"match_num"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contents"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Return value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned "},{"type":"codeVoice","code":"start_pos"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned "},{"type":"codeVoice","code":"end_pos"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Matches entire string"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"25"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"1"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Does not match first character"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"-1"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"-1"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"2"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All text before "},{"type":"codeVoice","code":"the "}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"17"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"3"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All text after "},{"type":"codeVoice","code":"the "}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"21"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"25"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Capture paren out of range"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"False"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unchanged"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unchanged"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code sample and output implements this example."}]},{"type":"codeListing","syntax":"{ .c }","code":["`include` <glib.h>","","int","main (int argc, char *argv[])","{","  `g_autoptr(GError)` local_error = NULL;","  const char *regex_pattern = \"(a)?(.*?)the (.*)\";","  const char *test_string = \"glib regexes are the best\";","  `g_autoptr(GRegex)` regex = NULL;","","  regex = g_regex_new (regex_pattern,","                       G_REGEX_DEFAULT,","                       G_REGEX_MATCH_DEFAULT,","                       &local_error);","  if (regex == NULL)","    {","      g_printerr (\"Error creating regex: `s`\\n\", local_error->message);","      return 1;","    }","","  `g_autoptr(GMatchInfo)` match_info = NULL;","  g_regex_match (regex, test_string, G_REGEX_MATCH_DEFAULT, &match_info);","","  int n_matched_strings = g_match_info_get_match_count (match_info);","","  \/\/ Print header line","  g_print (\"match_num Contents                  Return value returned start_pos returned end_pos\\n\");","","  \/\/ Iterate over each capture paren, including one that is out of range as a demonstration.","  for (int match_num = 0; match_num <= n_matched_strings; match_num++)","    {","      gboolean found_match;","      g_autofree char *paren_string = NULL;","      int start_pos = G_MAXINT;","      int end_pos = G_MAXINT;","","      found_match = g_match_info_fetch_pos (match_info,","                                            match_num,","                                            &start_pos,","                                            &end_pos);","","      \/\/ If no match, display N\/A as the found string.","      if (start_pos == G_MAXINT || start_pos == -1)","        paren_string = g_strdup (\"N\/A\");","      else","        paren_string = g_strndup (test_string + start_pos, end_pos - start_pos);","","      g_print (\"`-9d` `-25s` `-12d` `-18d` `d`\\n\", match_num, paren_string, found_match, start_pos, end_pos);","    }","","  return 0;","}"]},{"type":"codeListing","syntax":null,"code":["match_num Contents                  Return value returned start_pos returned end_pos","0         glib regexes are the best 1            0                  25","1         N\/A                       1            -1                 -1","2         glib regexes are          1            0                  17","3         best                      1            21                 25","4         N\/A                       0            2147483647         2147483647"]},{"anchor":"Methods-Using-Deterministic-Finite-Automata-Matching","level":2,"type":"heading","text":"Methods Using Deterministic Finite Automata Matching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The methods [method"},{"type":"codeVoice","code":"GLib.Regex.match_all"},{"type":"text","text":"] and"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GLib.Regex.match_all_full"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"return a "},{"type":"codeVoice","code":"GMatchInfo"},{"type":"text","text":" using"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/en.wikipedia.org\/wiki\/Deterministic_finite_automaton"},{"type":"text","text":" "},{"type":"text","text":"(DFA) pattern matching. This algorithm detects overlapping matches. You pass"},{"type":"text","text":" "},{"type":"text","text":"the returned "},{"type":"codeVoice","code":"GMatchInfo"},{"type":"text","text":" from these methods to "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"type":"text","text":" "},{"type":"text","text":"to determine the start and end positions of each overlapping match. Use the"},{"type":"text","text":" "},{"type":"text","text":"method [method"},{"type":"codeVoice","code":"GLib.MatchInfo.get_match_count"},{"type":"text","text":"] to determine the number"},{"type":"text","text":" "},{"type":"text","text":"of overlapping matches."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, a regex pattern is "},{"type":"codeVoice","code":"<.*>"},{"type":"text","text":", and a candidate string is"},{"type":"text","text":" "},{"type":"codeVoice","code":"<a> <b> <c>"},{"type":"text","text":". In this scenario there are three implicit capture"},{"type":"text","text":" "},{"type":"text","text":"parentheses: one for the entire string, one for "},{"type":"codeVoice","code":"<a> <b>"},{"type":"text","text":", and one for "},{"type":"codeVoice","code":"<a>"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Given this example, the following table describes the return values from"},{"type":"text","text":" "},{"type":"codeVoice","code":"g_match_info_fetch_pos()"},{"type":"text","text":" for various values of "},{"type":"codeVoice","code":"matchNum"},{"type":"text","text":"."}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"match_num"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Contents"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Return value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned "},{"type":"codeVoice","code":"start_pos"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned "},{"type":"codeVoice","code":"end_pos"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Matches entire string"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"11"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"1"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Matches "},{"type":"codeVoice","code":"<a> <b>"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"7"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"2"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Matches "},{"type":"codeVoice","code":"<a>"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"True"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"3"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"3"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Capture paren out of range"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"False"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unchanged"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unchanged"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following code sample and output implements this example."}]},{"type":"codeListing","syntax":"{ .c }","code":["`include` <glib.h>","","int","main (int argc, char *argv[])","{","  `g_autoptr(GError)` local_error = NULL;","  const char *regex_pattern = \"<.*>\";","  const char *test_string = \"<a> <b> <c>\";","  `g_autoptr(GRegex)` regex = NULL;","","  regex = g_regex_new (regex_pattern,","                       G_REGEX_DEFAULT,","                       G_REGEX_MATCH_DEFAULT,","                       &local_error);","  if (regex == NULL)","    {","      g_printerr (\"Error creating regex: `s`\\n\", local_error->message);","      return -1;","    }","","  `g_autoptr(GMatchInfo)` match_info = NULL;","  g_regex_match_all (regex, test_string, G_REGEX_MATCH_DEFAULT, &match_info);","","  int n_matched_strings = g_match_info_get_match_count (match_info);","","  \/\/ Print header line","  g_print (\"match_num Contents                  Return value returned start_pos returned end_pos\\n\");","","  \/\/ Iterate over each capture paren, including one that is out of range as a demonstration.","  for (int match_num = 0; match_num <= n_matched_strings; match_num++)","    {","      gboolean found_match;","      g_autofree char *paren_string = NULL;","      int start_pos = G_MAXINT;","      int end_pos = G_MAXINT;","","      found_match = g_match_info_fetch_pos (match_info, match_num, &start_pos, &end_pos);","","      \/\/ If no match, display N\/A as the found string.","      if (start_pos == G_MAXINT || start_pos == -1)","        paren_string = g_strdup (\"N\/A\");","      else","        paren_string = g_strndup (test_string + start_pos, end_pos - start_pos);","","      g_print (\"`-9d` `-25s` `-12d` `-18d` `d`\\n\", match_num, paren_string, found_match, start_pos, end_pos);","    }","","  return 0;","}"]},{"type":"codeListing","syntax":null,"code":["match_num Contents                  Return value returned start_pos returned end_pos","0         <a> <b> <c>               1            0                  11","1         <a> <b>                   1            0                  7","2         <a>                       1            0                  3","3         N\/A                       0            2147483647         2147483647"]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/glib\/matchinfo\/fetchpos(matchnum:startpos:endpos:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/MatchInfo\/fetchPos(matchNum:startPos:endPos:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Returns the start and end positions (in bytes) of a successfully matching"},{"type":"text","text":" "},{"type":"text","text":"capture parenthesis."}],"kind":"symbol","metadata":{"role":"symbol","title":"fetchPos(matchNum:startPos:endPos:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fetchPos"},{"kind":"text","text":"("},{"kind":"externalParam","text":"matchNum"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":", "},{"kind":"externalParam","text":"startPos"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gint","preciseIdentifier":"c:@T@gint"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"endPos"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafeMutablePointer","preciseIdentifier":"s:Sp"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"gint","preciseIdentifier":"c:@T@gint"},{"kind":"text","text":">!) -> "},{"kind":"typeIdentif