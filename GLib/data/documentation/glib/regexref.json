{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegexRef"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After instantiating a "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":", you can use its methods to find matches"},{"type":"text","text":" "},{"type":"text","text":"in a string, replace matches within a string, or split the string at matches."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" implements regular expression pattern matching using syntax and"},{"type":"text","text":" "},{"type":"text","text":"semantics (such as character classes, quantifiers, and capture groups)"},{"type":"text","text":" "},{"type":"text","text":"similar to Perl regular expression. See the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"man:pcre2pattern(3)"},{"type":"text","text":" for details."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical scenario for regex pattern matching is to check if a string"},{"type":"text","text":" "},{"type":"text","text":"matches a pattern. The following statements implement this scenario."}]},{"type":"codeListing","syntax":"{ .c }","code":["const char *regex_pattern = \".*GLib.*\";","const char *string_to_search = \"You will love the GLib implementation of regex\";","`g_autoptr(GMatchInfo)` match_info = NULL;","`g_autoptr(GRegex)` regex = NULL;","","regex = g_regex_new (regex_pattern, G_REGEX_DEFAULT, G_REGEX_MATCH_DEFAULT, NULL);","g_assert (regex != NULL);","","if (g_regex_match (regex, string_to_search, G_REGEX_MATCH_DEFAULT, &match_info))","  {","    int start_pos, end_pos;","    g_match_info_fetch_pos (match_info, 0, &start_pos, &end_pos);","    g_print (\"Match successful! Overall pattern matches bytes `d` to `d`\\n\", start_pos, end_pos);","  }","else","  {","    g_print (\"No match!\\n\");","  }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The constructor for "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" includes two sets of bitmapped flags:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[flags"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexCompileFlags"},{"type":"text","text":"]—These flags"},{"type":"text","text":" "},{"type":"text","text":"control how GLib compiles the regex. There are options for case"},{"type":"text","text":" "},{"type":"text","text":"sensitivity, multiline, ignoring whitespace, etc."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[flags"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexMatchFlags"},{"type":"text","text":"]—These flags control"},{"type":"text","text":" "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":"’s matching behavior, such as anchoring and customizing definitions"},{"type":"text","text":" "},{"type":"text","text":"for newline characters."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some regex patterns include backslash assertions, such as "},{"type":"codeVoice","code":"\\d"},{"type":"text","text":" (digit) or"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\D"},{"type":"text","text":" (non-digit). The regex pattern must escape those backslashes. For"},{"type":"text","text":" "},{"type":"text","text":"example, the pattern "},{"type":"codeVoice","code":"\"\\\\d\\\\D\""},{"type":"text","text":" matches a digit followed by a non-digit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"GLib’s implementation of pattern matching includes a "},{"type":"codeVoice","code":"start_position"},{"type":"text","text":" "},{"type":"text","text":"argument for some of the match, replace, and split methods. Specifying"},{"type":"text","text":" "},{"type":"text","text":"a start position provides flexibility when you want to ignore the first"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" characters of a string, but want to incorporate backslash assertions"},{"type":"text","text":" "},{"type":"text","text":"at character "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" - 1. For example, a database field contains inconsistent"},{"type":"text","text":" "},{"type":"text","text":"spelling for a job title: "},{"type":"codeVoice","code":"healthcare provider"},{"type":"text","text":" and "},{"type":"codeVoice","code":"health-care provider"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The database manager wants to make the spelling consistent by adding a"},{"type":"text","text":" "},{"type":"text","text":"hyphen when it is missing. The following regex pattern tests for the string"},{"type":"text","text":" "},{"type":"codeVoice","code":"care"},{"type":"text","text":" preceded by a non-word boundary character (instead of a hyphen)"},{"type":"text","text":" "},{"type":"text","text":"and followed by a space."}]},{"type":"codeListing","syntax":"{ .c }","code":["const char *regex_pattern = \"\\\\Bcare\\\\s\";"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An efficient way to match with this pattern is to start examining at"},{"type":"text","text":" "},{"type":"codeVoice","code":"start_position"},{"type":"text","text":" 6 in the string "},{"type":"codeVoice","code":"healthcare"},{"type":"text","text":" or "},{"type":"codeVoice","code":"health-care"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"{ .c }","code":["const char *regex_pattern = \"\\\\Bcare\\\\s\";","const char *string_to_search = \"healthcare provider\";","`g_autoptr(GMatchInfo)` match_info = NULL;","`g_autoptr(GRegex)` regex = NULL;","","regex = g_regex_new (","  regex_pattern,","  G_REGEX_DEFAULT,","  G_REGEX_MATCH_DEFAULT,","  NULL);","g_assert (regex != NULL);","","g_regex_match_full (","  regex,","  string_to_search,","  -1,","  6, \/\/ position of 'c' in the test string.","  G_REGEX_MATCH_DEFAULT,","  &match_info,","  NULL);"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The method [method"},{"type":"codeVoice","code":"GLib.Regex.match_full"},{"type":"text","text":"] (and other methods implementing"},{"type":"text","text":" "},{"type":"codeVoice","code":"start_pos"},{"type":"text","text":") allow for lookback before the start position to determine if"},{"type":"text","text":" "},{"type":"text","text":"the previous character satisfies an assertion."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unless you set the [flags"},{"type":"codeVoice","code":"GLib.RegexCompileFlags.RAW"},{"type":"text","text":"] as one of"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"GRegexCompileFlags"},{"type":"text","text":", all the strings passed to "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" methods must"},{"type":"text","text":" "},{"type":"text","text":"be encoded in UTF-8. The lengths and the positions inside the strings are"},{"type":"text","text":" "},{"type":"text","text":"in bytes and not in characters, so, for instance, "},{"type":"codeVoice","code":"\\xc3\\xa0"},{"type":"text","text":" (i.e., "},{"type":"codeVoice","code":"à"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"is two bytes long but it is treated as a single character. If you set"},{"type":"text","text":" "},{"type":"codeVoice","code":"G_REGEX_RAW"},{"type":"text","text":", the strings can be non-valid UTF-8 strings and a byte is"},{"type":"text","text":" "},{"type":"text","text":"treated as a character, so "},{"type":"codeVoice","code":"\\xc3\\xa0"},{"type":"text","text":" is two bytes and two characters long."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Regarding line endings, "},{"type":"codeVoice","code":"\\n"},{"type":"text","text":" matches a "},{"type":"codeVoice","code":"\\n"},{"type":"text","text":" character, and "},{"type":"codeVoice","code":"\\r"},{"type":"text","text":" matches"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"\\r"},{"type":"text","text":" character. More generally, "},{"type":"codeVoice","code":"\\R"},{"type":"text","text":" matches all typical line endings:"},{"type":"text","text":" "},{"type":"text","text":"CR + LF ("},{"type":"codeVoice","code":"\\r\\n"},{"type":"text","text":"), LF (linefeed, U+000A, "},{"type":"codeVoice","code":"\\n"},{"type":"text","text":"), VT (vertical tab, U+000B,"},{"type":"text","text":" "},{"type":"codeVoice","code":"\\v"},{"type":"text","text":"), FF (formfeed, U+000C, "},{"type":"codeVoice","code":"\\f"},{"type":"text","text":"), CR (carriage return, U+000D, "},{"type":"codeVoice","code":"\\r"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"NEL (next line, U+0085), LS (line separator, U+2028), and PS (paragraph"},{"type":"text","text":" "},{"type":"text","text":"separator, U+2029)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The behaviour of the dot, circumflex, and dollar metacharacters are"},{"type":"text","text":" "},{"type":"text","text":"affected by newline characters. By default, "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" matches any newline"},{"type":"text","text":" "},{"type":"text","text":"character matched by "},{"type":"codeVoice","code":"\\R"},{"type":"text","text":". You can limit the matched newline characters by"},{"type":"text","text":" "},{"type":"text","text":"specifying the [flags"},{"type":"codeVoice","code":"GLib.RegexMatchFlags.NEWLINE_CR"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"[flags"},{"type":"codeVoice","code":"GLib.RegexMatchFlags.NEWLINE_LF"},{"type":"text","text":"], and"},{"type":"text","text":" "},{"type":"text","text":"[flags"},{"type":"codeVoice","code":"GLib.RegexMatchFlags.NEWLINE_CRLF"},{"type":"text","text":"] compile options, and"},{"type":"text","text":" "},{"type":"text","text":"with [flags"},{"type":"codeVoice","code":"GLib.RegexMatchFlags.NEWLINE_ANY"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"[flags"},{"type":"codeVoice","code":"GLib.RegexMatchFlags.NEWLINE_CR"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"[flags"},{"type":"codeVoice","code":"GLib.RegexMatchFlags.NEWLINE_LF"},{"type":"text","text":"] and"},{"type":"text","text":" "},{"type":"text","text":"[flags"},{"type":"codeVoice","code":"GLib.RegexMatchFlags.NEWLINE_CRLF"},{"type":"text","text":"] match options."},{"type":"text","text":" "},{"type":"text","text":"These settings are also relevant when compiling a pattern if"},{"type":"text","text":" "},{"type":"text","text":"[flags"},{"type":"codeVoice","code":"GLib.RegexCompileFlags.EXTENDED"},{"type":"text","text":"] is set and an unescaped"},{"type":"text","text":" "},{"type":"codeVoice","code":"#"},{"type":"text","text":" outside a character class is encountered. This indicates a comment"},{"type":"text","text":" "},{"type":"text","text":"that lasts until after the next newline."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" does not modify its internal state between creation and"},{"type":"text","text":" "},{"type":"text","text":"destruction, you can create and modify the same "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" instance from"},{"type":"text","text":" "},{"type":"text","text":"different threads. In contrast, [struct"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/MatchInfo"},{"type":"text","text":"] is not thread safe."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The regular expression low-level functionalities are obtained through"},{"type":"text","text":" "},{"type":"text","text":"the excellent "},{"type":"reference","isActive":true,"identifier":"http:\/\/www.pcre.org\/"},{"type":"text","text":" library written by Philip Hazel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexRef"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexProtocol"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexRef"},{"type":"text","text":" only as an "},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference to an existing "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/Regex"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/GLib\/documentation\/GLib\/RegexRef"},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" instance."}]}],"type":"aside","name":"Note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/glib\/regexref"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/GLib\/documentation\/GLib\/PointerWrapper","doc:\/\/GLib\/documentation\/GLib\/RegexProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/RegexRef","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"GRegex"},{"type":"text","text":" is a compiled form of a regular expression."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegexRef"}],"title":"RegexRef","roleHeading":"Structure","role":"symbol","symbolKind":"struct","externalID":"s:4GLib8RegexRefV","modules":[{"name":"GLib"}],"navigatorTitle":[{"kind":"identifier","text":"RegexRef"}]},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(_:)-1hgnb","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(_:)-1vppv","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(_:)-2yoe7","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(_:)-51y4h","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(_:)-7dujh","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(cPointer:)","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(constPointer:)","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(gconstpointer:)","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(gpointer:)","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(mutating:)","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(opaquePointer:)","doc:\/\/GLib\/documentation\/GLib\/RegexRef\/init(pattern:compileOptions:matchOptions:)"]},{"title":"Instance Properties","identifiers":["doc:\/\/GLib\/documentation\/GLib\/RegexRef\/ptr"]},{"title":"Default Implementations","identifiers":["doc:\/\/GLib\/documentation\/GLib\/RegexRef\/PointerWrapper-Implementations","doc:\/\/GLib\/documentation\