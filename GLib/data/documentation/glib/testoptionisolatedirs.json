{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"testOptionIsolateDirs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Creates a unique temporary directory for each unit test and uses sets"},{"type":"text","text":" "},{"type":"text","text":"XDG directories to point into subdirectories of it for the duration of"},{"type":"text","text":" "},{"type":"text","text":"the unit test. The directory tree is cleaned up after the test finishes"},{"type":"text","text":" "},{"type":"text","text":"successfully."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that this doesn’t take effect until [func"},{"type":"codeVoice","code":"GLib.test_run"},{"type":"text","text":"] is called,"},{"type":"text","text":" "},{"type":"text","text":"so calls to (for example) [func"},{"type":"codeVoice","code":"GLib.get_home_dir"},{"type":"text","text":"] will return the"},{"type":"text","text":" "},{"type":"text","text":"system-wide value when made in a test program’s "},{"type":"codeVoice","code":"main()"},{"type":"text","text":" function."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following functions will return subdirectories of the temporary directory"},{"type":"text","text":" "},{"type":"text","text":"when this option is used. The specific subdirectory paths in use are not"},{"type":"text","text":" "},{"type":"text","text":"guaranteed to be stable API — always use a getter function to retrieve them."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_home_dir"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_cache_dir"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_system_config_dirs"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_config_dir"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_system_data_dirs"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_data_dir"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_state_dir"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[func"},{"type":"codeVoice","code":"GLib.get_user_runtime_dir"},{"type":"text","text":"]"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The subdirectories may not be created by the test harness; as with normal"},{"type":"text","text":" "},{"type":"text","text":"calls to functions like [func"},{"type":"codeVoice","code":"GLib.get_user_cache_dir"},{"type":"text","text":"], the caller must"},{"type":"text","text":" "},{"type":"text","text":"be prepared to create the directory if it doesn’t exist."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/glib\/testoptionisolatedirs"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GLib\/documentation\/GLib\/testOptionIsolateDirs","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A value that can be passed as an option to [func"},{"type":"codeVoice","code":"GLib.test_init"},{"type":"text","text":"]."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"testOptionIsolateDirs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"title":"testOptionIsolateDirs","roleHeading":"Global Variable","role":"symbol","symbolKind":"var","externalID":"s:4GLib21testOptionIsolateDirsSSvp","modules":[{"name":"GLib"}]},"hierarchy":{"paths":[["doc:\/\/GLib\/documentation\/GLib"]]},"references":{"doc://GLib/documentation/GLib/testOptionIsolateDirs":{"role":"symbol","title":"testOptionIsolateDirs","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"testOptionIsolateDirs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"abstract":[{"type":"text","text":"A value that can be passed as an option to [func"},{"type":"codeVoice","code":"GLib.test_init"},{"type":"text","text":"]."}],"identifier":"doc:\/\/GLib\/documentation\/GLib\/testOptionIsolateDirs","kind":"symbol","type":"topic","url":"\/documentation\/glib\/testoptionisolatedirs"},"doc://GLib/documentation/GLib":{"role":"collection","title":"GLib","abstract":[],"identifier":"doc:\/\/GLib\/documentation\/GLib","kind":"symbol","type":"topic","url":"\/documentation\/glib"}}}