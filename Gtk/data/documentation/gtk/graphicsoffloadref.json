{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphicsOffloadRef"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Graphics offload is an optimization to reduce overhead and battery use that is"},{"type":"text","text":" "},{"type":"text","text":"most useful for video content. It only works on some platforms and in certain"},{"type":"text","text":" "},{"type":"text","text":"situations. GTK will automatically fall back to normal rendering if it doesn’t."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Graphics offload is most efficient if there are no controls drawn on top of the"},{"type":"text","text":" "},{"type":"text","text":"video content."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You should consider using graphics offload for your main widget if it shows"},{"type":"text","text":" "},{"type":"text","text":"frequently changing content (such as a video, or a VM display) and you provide"},{"type":"text","text":" "},{"type":"text","text":"the content in the form of dmabuf textures (see [class"},{"type":"reference","isActive":true,"identifier":"\/\/documentation\/gdk\/dmabuftexturebuilder]"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"in particular if it may be fullscreen."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Numerous factors can prohibit graphics offload:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unsupported platforms. Currently, graphics offload only works on Linux with Wayland."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clipping, such as rounded corners that cause the video content to not be rectangular"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unsupported dmabuf formats (see [method"},{"type":"codeVoice","code":"Gdk.Display.get_dmabuf_formats"},{"type":"text","text":"])"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Translucent video content (content with an alpha channel, even if it isn’t used)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforms that are more complex than translations and scales"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Filters such as opacity, grayscale or similar"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To investigate problems related graphics offload, GTK offers debug flags to print"},{"type":"text","text":" "},{"type":"text","text":"out information about graphics offload and dmabuf use:"}]},{"type":"codeListing","syntax":null,"code":["GDK_DEBUG=offload","GDK_DEBUG=dmabuf"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The GTK inspector provides a visual debugging tool for graphics offload."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/GraphicsOffloadRef"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GtkGraphicsOffload"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/GraphicsOffloadProtocol"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/GraphicsOffloadRef"},{"type":"text","text":" only as an "},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference to an existing "},{"type":"codeVoice","code":"GtkGraphicsOffload"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/GraphicsOffload"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/GraphicsOffloadRef"},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"type":"codeVoice","code":"GtkGraphicsOffload"},{"type":"text","text":" instance."}]}],"type":"aside","name":"Note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gtk\/graphicsoffloadref"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/Gtk\/documentation\/Gtk\/AccessibleProtocol","doc:\/\/Gtk\/documentation\/Gtk\/BuildableProtocol","doc:\/\/Gtk\/documentation\/Gtk\/ConstraintTargetProtocol","doc:\/\/Gtk\/4GLib14PointerWrapperP","doc:\/\/Gtk\/10GLibObject14GWeakCapturingP","doc:\/\/Gtk\/10GLibObject24InitiallyUnownedProtocolP","doc:\/\/Gtk\/10GLibObject0B8ProtocolP","doc:\/\/Gtk\/documentation\/Gtk\/GraphicsOffloadProtocol","doc:\/\/Gtk\/documentation\/Gtk\/WidgetProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/Gtk\/documentation\/Gtk\/GraphicsOffloadRef","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A widget that allows to bypass gsk rendering for its child by passing the content"},{"type":"text","text":" "},{"type":"text","text":"directly to the compositor."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GraphicsOffloadRef"}],"title":"GraphicsOffloadRef","roleHeading":"Structure","role":"symbol","symbolKind":"struct","externalID":"s:3Gtk18GraphicsOffloadR