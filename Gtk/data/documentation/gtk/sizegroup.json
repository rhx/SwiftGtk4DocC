fe untyped initialiser."},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Do not use unless you know the underlying data type the pointer points to conforms to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SizeGroupProtocol"},{"type":"text","text":"."}]}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SizeGroup\/init(raw:)-8h4nh","kind":"symbol","type":"topic","url":"\/documentation\/gtk\/sizegroup\/init(raw:)-8h4nh"},"doc://Gtk/documentation/Gtk/SizeGroupRef":{"role":"symbol","title":"SizeGroupRef","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SizeGroupRef"}],"abstract":[{"type":"text","text":"Groups widgets together so they all request the same size."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SizeGroupRef","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SizeGroupRef"}],"url":"\/documentation\/gtk\/sizegroupref"},"#method@Gtk.SizeGroup.set_mode":{"title":"mode","titleInlineContent":[{"type":"text","text":"mode"}],"type":"link","identifier":"#method@Gtk.SizeGroup.set_mode","url":"#method@Gtk.SizeGroup.set_mode"},"doc://Gtk/documentation/Gtk/SizeGroup/init(_:)-4i7f6":{"role":"symbol","title":"init(_:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"GtkSizeGroup"},{"kind":"text","text":">)"}],"abstract":[{"type":"text","text":"Designated initialiser from a constant pointer to the underlying "},{"type":"codeVoice","code":"C"},{"type":"text","text":" data type."},{"type":"text","text":" "},{"type":"text","text":"This creates an instance without performing an unbalanced retain"},{"type":"text","text":" "},{"type":"text","text":"i.e., ownership is transferred to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentati