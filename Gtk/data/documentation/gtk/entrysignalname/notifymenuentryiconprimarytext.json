{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notifyMenuEntryIconPrimaryText"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the primary icon is activatable and this property has been set, a new entry"},{"type":"text","text":" "},{"type":"text","text":"in the context menu of this GtkEntry will appear with this text. Selecting that"},{"type":"text","text":" "},{"type":"text","text":"menu entry will result in the primary icon being activated, exactly in the same way"},{"type":"text","text":" "},{"type":"text","text":"as it would be activated from a mouse click."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This simplifies adding accessibility support to applications using activatable"},{"type":"text","text":" "},{"type":"text","text":"icons. The activatable icons aren’t focusable when navigating the interface with"},{"type":"text","text":" "},{"type":"text","text":"the keyboard This is why Gtk recommends to also add those actions in the context"},{"type":"text","text":" "},{"type":"text","text":"menu. This set of methods greatly simplifies this, by adding a menu item that, when"},{"type":"text","text":" "},{"type":"text","text":"enabled, calls the same callback than clicking on the icon."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gtk\/entrysignalname\/notifymenuentryiconprimarytext"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gtk\/documentation\/Gtk\/EntrySignalName\/notifyMenuEntryIconPrimaryText","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Text for an item in the context menu to activate the primary icon action."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notifyMenuEntryIconPrimaryText"}],"title":"EntrySignalName.notifyMenuEntryIconPrimaryText","roleHeading":"Case","role":"symbol","symbolKind":"case","externalID":"s:3Gtk15EntrySignalNameO010notifyMenuB15IconPrimaryTextyA2CmF","modules":[{"name":"Gtk"}]},"hierarchy":{"paths":[["doc:\/\/Gtk\/documentation\/Gtk","doc:\/\/Gtk\/documentation\/Gtk\/EntrySignalName"]]},"references":{"doc://Gtk/documentation/Gtk/EntrySignalName/notifyMenuEntryIconPrimaryText":{"role":"symbol","title":"EntrySignalName.notifyMenuEntryIconPrimaryText","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"notifyMenuEntryIconPrimaryText"}],"abstract":[{"type":"text","text":"Text for an item in the context menu to activate the primary icon action."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/EntrySignalName\/notifyMenuEntryIconPrimaryText","kind":"symbol","type":"topic","url":"\/documentation\/gtk\/entrysignalname\/notifymenuentryiconprimarytext"},"doc://Gtk/documentation/Gtk":{"role":"collection","title":"Gtk","abstract":[],"identifier":"doc:\/\/Gtk\/documentation\/Gtk","kind":"symbol","type":"topic","url":"\/documentation\/gtk"},"doc://Gtk/documentation/Gtk/EntrySignalName":{"role":"symbol","title":"EntrySignalName","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntrySignalName"}],"abstract":[],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/EntrySignalName","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"EntrySignalName"}],"url":"\/documentation\/gtk\/entrysignalname"}}}