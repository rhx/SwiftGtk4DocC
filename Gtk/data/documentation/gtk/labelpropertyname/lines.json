{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"lines"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":":"},{"type":"text","text":" warning"},{"type":"text","text":" "},{"type":"text","text":"Setting this property has unintuitive and unfortunate consequences"},{"type":"text","text":" "},{"type":"text","text":"for the minimum "},{"type":"emphasis","inlineContent":[{"type":"text","text":"width"}]},{"type":"text","text":" of the label. Specifically, if the height"},{"type":"text","text":" "},{"type":"text","text":"of the label is such that it fits a smaller number of lines than"},{"type":"text","text":" "},{"type":"text","text":"the value of this property, the label can not be ellipsized at all,"},{"type":"text","text":" "},{"type":"text","text":"which means it must be wide enough to fit all the text fully."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This property has no effect if the label is not wrapping or ellipsized."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set this property to -1 if you don’t want to limit the number of lines."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gtk\/labelpropertyname\/lines"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gtk\/documentation\/Gtk\/LabelPropertyName\/lines","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The number of lines to which an ellipsized, wrapping label"},{"type":"text","text":" "},{"type":"text","text":"should display before it gets ellipsized. This both prevents the label"},{"type":"text","text":" "},{"type":"text","text":"from ellipsizing before this many lines are displayed, and limits the"},{"type":"text","text":" "},{"type":"text","text":"height request of the label to this many lines."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"lines"}],"title":"LabelPropertyName.lines","roleHeading":"Case","role":"symbol","symbolKind":"case","externalID":"s:3Gtk17LabelPropertyNameO5linesyA2CmF","modules":[{"name":"Gtk"}]},"hierarchy":{"paths":[["doc:\/\/Gtk\/documentation\/Gtk","doc:\/\/Gtk\/documentation\/Gtk\/LabelPropertyName"]]},"references":{"doc://Gtk/documentation/Gtk":{"role":"collection","title":"Gtk","abstract":[],"identifier":"doc:\/\/Gtk\/documentation\/Gtk","kind":"symbol","type":"topic","url":"\/documentation\/gtk"},"doc://Gtk/documentation/Gtk/LabelPropertyName/lines":{"role":"symbol","title":"LabelPropertyName.lines","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"lines"}],"abstract":[{"type":"text","text":"The number of lines to which an ellipsized, wrapping label"},{"type":"text","text":" "},{"type":"text","text":"should display before it gets ellipsized. This both prevents the label"},{"type":"text","text":" "},{"type":"text","text":"from ellipsizing before this many lines are displayed, and limits the"},{"type":"text","text":" "},{"type":"text","text":"height request of the label to this many lines."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/LabelPropertyName\/lines","kind":"symbol","type":"topic","url":"\/documentation\/gtk\/labelpropertyname\/lines"},"doc://Gtk/documentation/Gtk/LabelPropertyName":{"role":"symbol","title":"LabelPropertyName","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"LabelPropertyName"}],"abstract":[],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/LabelPropertyName","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"LabelPropertyName"}],"url":"\/documentation\/gtk\/labelpropertyname"}}}