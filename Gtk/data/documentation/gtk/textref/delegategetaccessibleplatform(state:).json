{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delegateGetAccessiblePlatform"},{"kind":"text","text":"("},{"kind":"externalParam","text":"state"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GtkAccessiblePlatformState","preciseIdentifier":"c:@EA@GtkAccessiblePlatformState"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is an helper function to retrieve the accessible state for"},{"type":"text","text":" "},{"type":"codeVoice","code":"GtkEditable"},{"type":"text","text":" interface implementations using a delegate pattern."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You should call this function in your editable widget implementation"},{"type":"text","text":" "},{"type":"text","text":"of the [vfunc"},{"type":"codeVoice","code":"Gtk.Accessible.get_platform_state"},{"type":"text","text":"] virtual function, for"},{"type":"text","text":" "},{"type":"text","text":"instance:"}]},{"type":"codeListing","syntax":"c","code":["static void","accessible_interface_init (GtkAccessibleInterface *iface)","{","  iface->get_platform_state = your_editable_get_accessible_platform_state;","}","","static gboolean","your_editable_get_accessible_platform_state (GtkAccessible *accessible,","                                             GtkAccessiblePlatformState state)","{","  return gtk_editable_delegate_get_accessible_platform_state (GTK_EDITABLE (accessible), state);","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the widget which is the delegate "},{"type":"emphasis","inlineContent":[{"type":"text","text":"must"}]},{"type":"text","text":" be a direct child of"},{"type":"text","text":" "},{"type":"text","text":"this widget, otherwise your implementation of [vfunc"},{"type":"codeVoice","code":"Gtk.Accessible.get_platform_state"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"might not even be called, as the platform change will originate from"},{"type":"text","text":" "},{"type":"text","text":"the parent of the delegate, and, as a result, will not work properly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"So, if you can’t ensure the direct child condition, you should give the"},{"type":"text","text":" "},{"type":"text","text":"delegate the "},{"type":"codeVoice","code":"textBox"},{"type":"text","text":" role, or you can"},{"type":"text","text":" "},{"type":"text","text":"change your tree to allow this function to work."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gtk\/textref\/delegategetaccessibleplatform(state:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gtk\/documentation\/Gtk\/TextRef\/delegateGetAccessiblePlatform(state:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Retrieves the accessible platform state from the editable delegate."}],"kind":"symbol","metadata":{"role":"symbol","title":"delegateGetAccessiblePlatform(state:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delegateGetAccessiblePlatform"},{"kind":"text","text":"("},{"kind":"externalParam","text":"state"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GtkAccessiblePlatformState","preciseIdentifier":"c:@EA@GtkAccessiblePlatformState"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"symbolKind":"method","externalID":"s:3Gtk16EditableProtocolPAAE29delegateGetAccessiblePlatform5stateSbSo0afG5Statea_tF::SYNTHESIZED::s:3Gtk7TextRefV","ex