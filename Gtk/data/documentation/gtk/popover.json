{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Popover"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is primarily meant to provide context-dependent information"},{"type":"text","text":" "},{"type":"text","text":"or options. Popovers are attached to a parent widget. The parent widget"},{"type":"text","text":" "},{"type":"text","text":"must support popover children, as [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/MenuButton"},{"type":"text","text":"] and"},{"type":"text","text":" "},{"type":"text","text":"[class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/PopoverMenuBar"},{"type":"text","text":"] do. If you want to make a custom widget that"},{"type":"text","text":" "},{"type":"text","text":"has an attached popover, you need to call [method"},{"type":"codeVoice","code":"Gtk.Popover.present"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"in your [vfunc"},{"type":"codeVoice","code":"Gtk.Widget.size_allocate"},{"type":"text","text":"] vfunc, in order to update the"},{"type":"text","text":" "},{"type":"text","text":"positioning of the popover."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The position of a popover relative to the widget it is attached to"},{"type":"text","text":" "},{"type":"text","text":"can also be changed with [method"},{"type":"codeVoice","code":"Gtk.Popover.set_position"},{"type":"text","text":"]. By default,"},{"type":"text","text":" "},{"type":"text","text":"it points to the whole widget area, but it can be made to point to"},{"type":"text","text":" "},{"type":"text","text":"a specific area using [method"},{"type":"codeVoice","code":"Gtk.Popover.set_pointing_to"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default, "},{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":" performs a grab, in order to ensure input"},{"type":"text","text":" "},{"type":"text","text":"events get redirected to it while it is shown, and also so the popover"},{"type":"text","text":" "},{"type":"text","text":"is dismissed in the expected situations (clicks outside the popover,"},{"type":"text","text":" "},{"type":"text","text":"or the Escape key being pressed). If no such modal behavior is desired"},{"type":"text","text":" "},{"type":"text","text":"on a popover, [method"},{"type":"codeVoice","code":"Gtk.Popover.set_autohide"},{"type":"text","text":"] may be called on it to"},{"type":"text","text":" "},{"type":"text","text":"tweak its behavior."}]},{"anchor":"GtkPopover-as-menu-replacement","level":2,"type":"heading","text":"GtkPopover as menu replacement"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":" is often used to replace menus. The best way to do this"},{"type":"text","text":" "},{"type":"text","text":"is to use the [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/PopoverMenu"},{"type":"text","text":"] subclass which supports being"},{"type":"text","text":" "},{"type":"text","text":"populated from a "},{"type":"codeVoice","code":"GMenuModel"},{"type":"text","text":" with [ctor"},{"type":"codeVoice","code":"Gtk.PopoverMenu.new_from_model"},{"type":"text","text":"]."}]},{"type":"codeListing","syntax":"xml","code":["<section>","  <attribute name=\"display-hint\">horizontal-buttons<\/attribute>","  <item>","    <attribute name=\"label\">Cut<\/attribute>","    <attribute name=\"action\">app.cut<\/attribute>","    <attribute name=\"verb-icon\">edit-cut-symbolic<\/attribute>","  <\/item>","  <item>","    <attribute name=\"label\">Copy<\/attribute>","    <attribute name=\"action\">app.copy<\/attribute>","    <attribute name=\"verb-icon\">edit-copy-symbolic<\/attribute>","  <\/item>","  <item>","    <attribute name=\"label\">Paste<\/attribute>","    <attribute name=\"action\">app.paste<\/attribute>","    <attribute name=\"verb-icon\">edit-paste-symbolic<\/attribute>","  <\/item>","<\/section>"]},{"anchor":"Shortcuts-and-Gestures","level":1,"type":"heading","text":"Shortcuts and Gestures"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":" supports the following keyboard shortcuts:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape"},{"type":"text","text":" closes the popover."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alt"},{"type":"text","text":" makes the mnemonics visible."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following signals have default keybindings:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Popover](\/\/documentation\/gtk\/popover\/onactivatedefault(flags:handler:)]"}]}]}]},{"anchor":"CSS-nodes","level":1,"type":"heading","text":"CSS nodes"},{"type":"codeListing","syntax":null,"code":["popover.background[.menu]","├── arrow","╰── contents","    ╰── <child>"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":" has a main node with name "},{"type":"codeVoice","code":"popover"},{"type":"text","text":", an arrow with name "},{"type":"codeVoice","code":"arrow"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and another node for the content named "},{"type":"codeVoice","code":"contents"},{"type":"text","text":". The "},{"type":"codeVoice","code":"popover"},{"type":"text","text":" node always"},{"type":"text","text":" "},{"type":"text","text":"gets the "},{"type":"codeVoice","code":".background"},{"type":"text","text":" style class. It also gets the "},{"type":"codeVoice","code":".menu"},{"type":"text","text":" style class"},{"type":"text","text":" "},{"type":"text","text":"if the popover is menu-like, e.g. is a [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/PopoverMenu"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Particular uses of "},{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":", such as touch selection popups or"},{"type":"text","text":" "},{"type":"text","text":"magnifiers in "},{"type":"codeVoice","code":"GtkEntry"},{"type":"text","text":" or "},{"type":"codeVoice","code":"GtkTextView"},{"type":"text","text":" get style classes like"},{"type":"text","text":" "},{"type":"codeVoice","code":".touch-selection"},{"type":"text","text":" or "},{"type":"codeVoice","code":".magnifier"},{"type":"text","text":" to differentiate from plain popovers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When styling a popover directly, the "},{"type":"codeVoice","code":"popover"},{"type":"text","text":" node should usually"},{"type":"text","text":" "},{"type":"text","text":"not have any background. The visible part of the popover can have"},{"type":"text","text":" "},{"type":"text","text":"a shadow. To specify it in CSS, set the box-shadow of the "},{"type":"codeVoice","code":"contents"},{"type":"text","text":" node."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that, in order to accomplish appropriate arrow visuals, "},{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":" "},{"type":"text","text":"uses custom drawing for the "},{"type":"codeVoice","code":"arrow"},{"type":"text","text":" node. This makes it possible for the"},{"type":"text","text":" "},{"type":"text","text":"arrow to change its shape dynamically, but it also limits the possibilities"},{"type":"text","text":" "},{"type":"text","text":"of styling it using CSS. In particular, the "},{"type":"codeVoice","code":"arrow"},{"type":"text","text":" gets drawn over the"},{"type":"text","text":" "},{"type":"codeVoice","code":"content"},{"type":"text","text":" node’s border and shadow, so they look like one shape, which"},{"type":"text","text":" "},{"type":"text","text":"means that the border width of the "},{"type":"codeVoice","code":"content"},{"type":"text","text":" node and the "},{"type":"codeVoice","code":"arrow"},{"type":"text","text":" node should"},{"type":"text","text":" "},{"type":"text","text":"be the same. The arrow also does not support any border shape other than"},{"type":"text","text":" "},{"type":"text","text":"solid, no border-radius, only one border width (border-bottom-width is"},{"type":"text","text":" "},{"type":"text","text":"used) and no box-shadow."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Popover"},{"type":"text","text":" type acts as a reference-counted owner of an underlying "},{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It provides the methods that can operate on this data type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/PopoverProtocol"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Popover"},{"type":"text","text":" as a strong reference or owner of a "},{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/PopoverRef"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Popover"},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GtkPopover"},{"type":"text","text":" instance."}]}],"type":"aside","name":"Note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gtk\/popover"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/Gtk\/documentation\/Gtk\/Widget"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"},{"identifiers":["doc:\/\/Gtk\/documentation\/Gtk\/EmojiChooser","doc:\/\/Gtk\/documentation\/Gtk\/PopoverMenu"],"kind":"relationships","title":"Inherited By","type":"inheritedBy"},{"identifiers":["doc:\/\/Gtk\/documentation\/Gtk\/AccessibleProtocol","doc:\/\/Gtk\/documentation\/Gtk\/BuildableProtocol","doc:\/\/Gtk\/documentation\/Gtk\/ConstraintTargetProtocol","doc:\/\/Gtk\/4GLib14PointerWrapperP","doc:\/\/Gtk\/10GLibObject24InitiallyUnownedProtocolP","doc:\/\/Gtk\/10GLibObject0B8ProtocolP","doc:\/\/Gtk\/documentation\/Gtk\/NativeProtocol","doc:\/\/Gtk\/documentation\/Gtk\/PopoverProtocol","doc:\/\/Gtk\/documentation\/Gtk\/ShortcutManagerProtocol","doc:\/\/Gtk\/documentation\/Gtk\/WidgetProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/Gtk\/documentation\/Gtk\/Popover","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Presents a bubble-like popup."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Popover"}],"title":"Popover","roleHeading":"Class","role":"symbol","symbolKind":"class","externalID":"s:3Gtk7PopoverC","modules":[{"name":"Gtk"}],"navigatorTitle":[{"kind":"identifier","text":"Popover"}]},"hierarchy":{"paths":[["doc:\/\/Gtk\/documentation\/Gtk"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Gtk\/documentation\/Gtk\/Popover\/init()","doc:\/\/Gtk\/documentation\