{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addTick"},{"kind":"text","text":"("},{"kind":"externalParam","text":"callback"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GtkTickCallback","preciseIdentifier":"c:gtkwidget.h@T@GtkTickCallback"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"userData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gpointer","preciseIdentifier":"c:gtypes.h@T@gpointer"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"notify"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GDestroyNotify","preciseIdentifier":"c:gtypes.h@T@GDestroyNotify"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Until the tick callback is removed, it will be called frequently"},{"type":"text","text":" "},{"type":"text","text":"(usually at the frame rate of the output device or as quickly as"},{"type":"text","text":" "},{"type":"text","text":"the application can be repainted, whichever is slower). For this"},{"type":"text","text":" "},{"type":"text","text":"reason, is most suitable for handling graphics that change every"},{"type":"text","text":" "},{"type":"text","text":"frame or every few frames."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The tick callback does not automatically imply a relayout or repaint."},{"type":"text","text":" "},{"type":"text","text":"If you want a repaint or relayout, and aren’t changing widget properties"},{"type":"text","text":" "},{"type":"text","text":"that would trigger that (for example, changing the text of a label),"},{"type":"text","text":" "},{"type":"text","text":"then you will have to call [method"},{"type":"codeVoice","code":"Gtk.Widget.queue_resize"},{"type":"text","text":"] or"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gtk.Widget.queue_draw"},{"type":"text","text":"] yourself."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gdk.FrameClock.get_frame_time"},{"type":"text","text":"] should generally be used"},{"type":"text","text":" "},{"type":"text","text":"for timing continuous animations and"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gdk.FrameTimings.get_predicted_presentation_time"},{"type":"text","text":"] should be"},{"type":"text","text":" "},{"type":"text","text":"used if you are trying to display isolated frames at particular times."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a more convenient alternative to connecting directly to the"},{"type":"text","text":" "},{"type":"text","text":"[signal[FrameClock](\/\/documentation\/gdk\/frameclock\/onupdate(flags:handler:)] signal of the frame clock, since you"},{"type":"text","text":" "},{"type":"text","text":"don’t have to worry about when a frame clock is assigned to a widget."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To remove a tick callback, pass the ID that is returned by this function"},{"type":"text","text":" "},{"type":"text","text":"to [method"},{"type":"codeVoice","code":"Gtk.Widget.remove_tick_callback"},{"type":"text","text":"]."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gtk\/mediacontrolsref\/addtick(callback:userdata:notify:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gtk\/documentation\/Gtk\/MediaControlsRef\/addTick(callback:userData:notify:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Queues an animation frame update and adds a callback to be called"},{"type":"text","text":" "},{"type":"text","text":"before each frame."}],"kind":"symbol","metadata":{"role":"symbol","title":"addTick(callback:userData:notify:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"addTick"},{"kind":"text","text":"("},{"kind":"externalParam","text":"callback"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GtkTickCallback","preciseIdentifier":"c:gtkwidget.h@T@GtkTickCallback"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"userData"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gpointer","preciseIdentifier":"c:gtypes.h@T@gpointer"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"notify"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GDestroyNotify","preciseIdentifier":"c:gtypes.h@T@GDestroyNotify"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"symbolKind":"method","externalID":"s:3Gtk14WidgetProtocolPAAE7addTick8callback8userData6notifySis5Int32VSpySo01_aB0VGSg_SpySo14_GdkFrameClockVGSgSvSgtXCSg_ARyARXCSgtF::SYNTHESIZED::s:3Gtk16MediaControlsRefV","extendedModule":"Gtk","modules":[{"name":"Gtk"}]},"hierarchy":{"paths":[["doc:\/\/Gtk\/documentation\/Gtk","doc:\/\/Gtk\/documentation\/Gtk\/MediaControlsRef","doc:\/\/Gtk\/documentation\/Gtk\/MediaControlsRef\/WidgetProtocol-Implementations"]]},"references":{"doc://Gtk/documentation/Gtk/MediaControlsRef":{"role":"symbol","title":"MediaControlsRef","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MediaControlsRef"}],"abstract":[{"type":"text","text":"Shows controls for video playback."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/MediaControlsRef","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MediaControlsRef"}],"url":"\/documentation\/gtk\/mediacontrolsref"},"doc://Gtk/documentation/Gt