{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextRef"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" is the common implementation of single-line text editing"},{"type":"text","text":" "},{"type":"text","text":"that is shared between [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Entry"},{"type":"text","text":"], [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/PasswordEntry"},{"type":"text","text":"],"},{"type":"text","text":" "},{"type":"text","text":"[class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SpinButton"},{"type":"text","text":"], and other widgets. In all of these, a "},{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" "},{"type":"text","text":"instance is used as the delegate for the [iface"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Editable"},{"type":"text","text":"] implementation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A large number of key bindings s supported by default. If the entered"},{"type":"text","text":" "},{"type":"text","text":"text is longer than the allocation of the widget, the widget will scroll"},{"type":"text","text":" "},{"type":"text","text":"so that the cursor position is visible."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using an entry for passwords and other sensitive information,"},{"type":"text","text":" "},{"type":"text","text":"it can be put into “password mode” using [method"},{"type":"codeVoice","code":"Gtk.Text.set_visibility"},{"type":"text","text":"]."},{"type":"text","text":" "},{"type":"text","text":"In this mode, entered text is displayed using an “invisible” character."},{"type":"text","text":" "},{"type":"text","text":"By default, GTK picks the best invisible character that is available"},{"type":"text","text":" "},{"type":"text","text":"in the current font, but it can be changed with"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gtk.Text.set_invisible_char"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to add icons or progress display in an entry, look at"},{"type":"text","text":" "},{"type":"text","text":"[class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Entry"},{"type":"text","text":"]. There are other alternatives for more specialized"},{"type":"text","text":" "},{"type":"text","text":"use cases, such as [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SearchEntry"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need multi-line editable text, use [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/TextView"},{"type":"text","text":"]."}]},{"anchor":"Shortcuts-and-Gestures","level":1,"type":"heading","text":"Shortcuts and Gestures"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" supports the following keyboard shortcuts:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift"},{"type":"text","text":"+"},{"type":"text","text":"F10"},{"type":"text","text":" or "},{"type":"text","text":"Menu"},{"type":"text","text":" opens the context menu."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ctrl"},{"type":"text","text":"+"},{"type":"text","text":"A"},{"type":"text","text":" or "},{"type":"text","text":"Ctrl"},{"type":"text","text":"+"},{"type":"text","text":"\/"},{"type":"text","text":" "},{"type":"text","text":"selects all the text."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ctrl"},{"type":"text","text":"+"},{"type":"text","text":"Shift"},{"type":"text","text":"+"},{"type":"text","text":"A"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"Ctrl"},{"type":"text","text":"+"},{"type":"text","text":"\\"},{"type":"text","text":" unselects all."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ctrl"},{"type":"text","text":"+"},{"type":"text","text":"Z"},{"type":"text","text":" undoes the last modification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ctrl"},{"type":"text","text":"+"},{"type":"text","text":"Y"},{"type":"text","text":" or "},{"type":"text","text":"Ctrl"},{"type":"text","text":"+"},{"type":"text","text":"Shift"},{"type":"text","text":"+"},{"type":"text","text":"Z"},{"type":"text","text":" "},{"type":"text","text":"redoes the last undone modification."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ctrl"},{"type":"text","text":"+"},{"type":"text","text":"Shift"},{"type":"text","text":"+"},{"type":"text","text":"T"},{"type":"text","text":" toggles the text direction."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clear"},{"type":"text","text":" clears the content."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, the following signals have default keybindings:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/onactivate(flags:handler:)]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/onbackspace(flags:handler:)]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/oncopyclipboard(flags:handler:)]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/oncutclipboard(flags:handler:)]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/ondeletefromcursor(flags:handler:)]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/oninsertemoji(flags:handler:)]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/onmovecursor(flags:handler:)]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/onpasteclipboard(flags:handler:)]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[signal[Text](\/\/documentation\/gtk\/text\/ontoggleoverwrite(flags:handler:)]"}]}]}]},{"anchor":"Actions","level":1,"type":"heading","text":"Actions"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" defines a set of built-in actions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clipboard.copy"},{"type":"text","text":" copies the contents to the clipboard."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clipboard.cut"},{"type":"text","text":" copies the contents to the clipboard and deletes it from"},{"type":"text","text":" "},{"type":"text","text":"the widget."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clipboard.paste"},{"type":"text","text":" inserts the contents of the clipboard into the widget."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"menu.popup"},{"type":"text","text":" opens the context menu."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"misc.insert-emoji"},{"type":"text","text":" opens the Emoji chooser."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"misc.toggle-visibility"},{"type":"text","text":" toggles the "},{"type":"codeVoice","code":"GtkText"},{"type":"text","text":":visibility property."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"misc.toggle-direction"},{"type":"text","text":" toggles the text direction."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"selection.delete"},{"type":"text","text":" deletes the current selection."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"selection.select-all"},{"type":"text","text":" selects all of the widgets content."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"text.redo"},{"type":"text","text":" redoes the last change to the contents."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"text.undo"},{"type":"text","text":" undoes the last change to the contents."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"text.clear"},{"type":"text","text":" removes all content."}]}]}]},{"anchor":"CSS-nodes","level":1,"type":"heading","text":"CSS nodes"},{"type":"codeListing","syntax":null,"code":["text[.read-only]","├── placeholder","├── undershoot.left","├── undershoot.right","├── [selection]","├── [cursor-handle[.top]","├── [cursor-handle.bottom]","├── [block-cursor]","├── [cursor-handle[.top\/.bottom][.insertion-cursor]]","╰── [window.popup]"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" has a main node with the name "},{"type":"codeVoice","code":"text"},{"type":"text","text":". Depending on the properties"},{"type":"text","text":" "},{"type":"text","text":"of the widget, the "},{"type":"codeVoice","code":".read-only"},{"type":"text","text":" style class may appear."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the entry has a selection, it adds a subnode with the name "},{"type":"codeVoice","code":"selection"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the entry is in overwrite mode, it adds a subnode with the name"},{"type":"text","text":" "},{"type":"codeVoice","code":"block-cursor"},{"type":"text","text":" that determines how the block cursor is drawn."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The CSS node for a context menu is added as a subnode with the name "},{"type":"codeVoice","code":"popup"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"undershoot"},{"type":"text","text":" nodes are used to draw the underflow indication when content"},{"type":"text","text":" "},{"type":"text","text":"is scrolled out of view. These nodes get the "},{"type":"codeVoice","code":".left"},{"type":"text","text":" or "},{"type":"codeVoice","code":".right"},{"type":"text","text":" style class"},{"type":"text","text":" "},{"type":"text","text":"added depending on where the indication is drawn."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When touch is used and touch selection handles are shown, they are using"},{"type":"text","text":" "},{"type":"text","text":"CSS nodes with name "},{"type":"codeVoice","code":"cursor-handle"},{"type":"text","text":". They get the "},{"type":"codeVoice","code":".top"},{"type":"text","text":" or "},{"type":"codeVoice","code":".bottom"},{"type":"text","text":" style"},{"type":"text","text":" "},{"type":"text","text":"class depending on where they are shown in relation to the selection. If"},{"type":"text","text":" "},{"type":"text","text":"there is just a single handle for the text cursor, it gets the style class"},{"type":"text","text":" "},{"type":"codeVoice","code":".insertion-cursor"},{"type":"text","text":"."}]},{"anchor":"Accessibility","level":1,"type":"heading","text":"Accessibility"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" uses the [enum"},{"type":"codeVoice","code":"Gtk.AccessibleRole.none"},{"type":"text","text":"] role, which causes it to be"},{"type":"text","text":" "},{"type":"text","text":"skipped for accessibility. This is because "},{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" is expected to be used"},{"type":"text","text":" "},{"type":"text","text":"as a delegate for a "},{"type":"codeVoice","code":"GtkEditable"},{"type":"text","text":" implementation that will be represented"},{"type":"text","text":" "},{"type":"text","text":"to accessibility."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/TextRef"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/TextProtocol"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/TextRef"},{"type":"text","text":" only as an "},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference to an existing "},{"type":"codeVoice","code":"GtkText"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Text"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/