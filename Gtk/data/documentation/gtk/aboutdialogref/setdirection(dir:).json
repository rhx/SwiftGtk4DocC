{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"setDirection"},{"kind":"text","text":"("},{"kind":"externalParam","text":"dir"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GtkTextDirection","preciseIdentifier":"c:@EA@GtkTextDirection"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This direction controls the primary direction for widgets"},{"type":"text","text":" "},{"type":"text","text":"containing text, and also the direction in which the children"},{"type":"text","text":" "},{"type":"text","text":"of a container are packed. The ability to set the direction is"},{"type":"text","text":" "},{"type":"text","text":"present in order so that correct localization into languages with"},{"type":"text","text":" "},{"type":"text","text":"right-to-left reading directions can be done."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generally, applications will let the default reading direction"},{"type":"text","text":" "},{"type":"text","text":"prevail, except for widgets where the children are arranged in"},{"type":"text","text":" "},{"type":"text","text":"an order that is explicitly visual rather than logical (such as"},{"type":"text","text":" "},{"type":"text","text":"buttons for text justification)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the direction is set to [enum"},{"type":"codeVoice","code":"Gtk.TextDirection.none"},{"type":"text","text":"], then"},{"type":"text","text":" "},{"type":"text","text":"the value set by [func"},{"type":"codeVoice","code":"Gtk.Widget.set_default_direction"},{"type":"text","text":"] will be used."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"pat