{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"opacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CDouble","preciseIdentifier":"s:s7CDoublea"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An opacity of 0 is fully transparent and an opacity of 1"},{"type":"text","text":" "},{"type":"text","text":"is fully opaque."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opacity works on both toplevel widgets and child widgets, although"},{"type":"text","text":" "},{"type":"text","text":"there are some limitations: For toplevel widgets, applying opacity"},{"type":"text","text":" "},{"type":"text","text":"depends on the capabilities of the windowing system. On X11, this"},{"type":"text","text":" "},{"type":"text","text":"has any effect only on X displays with a compositing manager, see"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gdk.Display.is_composited"},{"type":"text","text":"]. On Windows and Wayland it will"},{"type":"text","text":" "},{"type":"text","text":"always work, although setting a window’s opacity after the window"},{"type":"text","text":" "},{"type":"text","text":"has been shown may cause some flicker."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the opacity is inherited through inclusion — if you set"},{"type":"text","text":" "},{"type":"text","text":"a toplevel to be partially translucent, all of its content will"},{"type":"text","text":" "},{"type":"text","text":"appear translucent, since it is ultimatively rendered on that"},{"type":"text","text":" "},{"type":"text","text":"toplevel. The opacity value itself is not inherited by child"},{"type":"text","text":" "},{"type":"text","text":"widgets (since that would make widgets deeper in the hierarchy"},{"type":"text","text":" "},{"type":"text","text":"progressively more translucent). As a consequence, [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Popover"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"instances and other [iface"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Native"},{"type":"text","text":"] widgets with their own surface"},{"type":"text","text":" "},{"type":"text","text":"will use their own opacity value, and thus by default appear"},{"type":"text","text":" "},{"type":"text","text":"non-translucent, even if they are attached to a toplevel that"},{"type":"text","text":" "},{"type":"text","text":"is translucent."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gtk\/expanderref\/set(opacity:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gtk\/documentation\/Gtk\/ExpanderRef\/set(opacity:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Requests the widget to be rendered partially transparent."}],"kind":"symbol","metadata":{"role":"symbol","title":"set(opacity:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"opacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CDouble","preciseIdentifier":"s:s7CDoublea"},{"kind":"text","text":")"}],"symbolKind":"method","externalID":"s:3Gtk14WidgetProtocolPAAE3set7opacityySd_tF::SYNTHESIZED::s:3Gtk11ExpanderRefV","extendedModule":"Gtk","modules":[{"name":"Gtk"}]},"hierarchy":{"paths":[["doc:\/\/Gtk\/documentation\/Gtk","doc:\/\/Gtk\/documentation\/Gtk\/ExpanderRef","doc:\/\/Gtk\/documentation\/Gtk\/ExpanderRef\/WidgetProtocol-Implementations"]]},"references":{"doc://Gtk/documentation/Gtk/ExpanderRef/WidgetProtocol-Implementations":{"role":"collectionGroup","title":"WidgetProtocol Implementations","abstract":[],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/ExpanderRef\/WidgetProtocol-Implementations","kind":"article","type":"topic","url":"\/documentation\/gtk\/expanderref\/widgetprotocol-implementations"},"doc://Gtk/documentation/Gtk":{"role":"collection","title":"Gtk","abstract":[],"identifier":"doc:\/\/Gtk\/documentation\/Gtk","kind":"symbol","type":"topic","url":"\/documentation\/gtk"},"doc://Gtk/documentation/Gtk/ExpanderRef/set(opacity:)":{"role":"symbol","title":"set(opacity:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"opacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CDouble","preciseIdentifier":"s:s7CDoublea"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Requests the widget to be rendered partially transparent."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/ExpanderRef\/set(opacity:)","kind":"symbol","type":"topic","url":"\/documentation\/gtk\/expanderref\/set(opacity:)"},"doc://Gtk/documentation/Gtk/ExpanderRef":{"role":"symbol","title":"ExpanderRef","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ExpanderRef"}],"abstract":[{"type":"text","text":"Allows the user to reveal or conceal a child widget."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/ExpanderRef","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ExpanderRef"}],"url":"\/documentation\/gtk\/expanderref"},"doc://Gtk/documentation/Gtk/Native":{"role":"symbol","title":"Native","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Native"}],"abstract":[{"type":"text","text":"An interface for widgets that have their own [class[Surface](\/\/documentation\/gdk\/surface]."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Native","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Native"}],"url":"\/documentation\/gtk\/native"},"doc://Gtk/documentation/Gtk/Popover":{"role":"symbol","title":"Popover","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Popover"}],"abstract":[{"type":"text","text":"Presents a bubble-like popup."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Popover","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Popover"}],"url":"\/documentation\/gtk\/popover"}}}