Mode"},{"type":"text","text":" of the size group."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SizeGroupProtocol\/set(mode:)","kind":"symbol","type":"topic","url":"\/documentation\/gtk\/sizegroupprotocol\/set(mode:)"},"#method@Gtk.Widget.set_hexpand":{"title":"the expand flags","titleInlineContent":[{"type":"text","text":"the expand flags"}],"type":"link","identifier":"#method@Gtk.Widget.set_hexpand","url":"#method@Gtk.Widget.set_hexpand"},"doc://Gtk/documentation/Gtk/SizeGroupProtocol/bind(property:to:_:flags:transformFrom:transformTo:)":{"role":"symbol","title":"bind(property:to:_:flags:transformFrom:transformTo:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bind"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Q"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"externalParam","text":"property"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SizeGroupPropertyName","preciseIdentifier":"s:3Gtk21SizeGroupPropertyNameO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Q"},{"kind":"text","text":", "},{"kind":"externalParam","text":"flags"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BindingFlags","preciseIdentifier":"s:10GLibObject12BindingFlagsV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transformFrom"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ValueTransformer","preciseIdentifier":"s:10GLibObject16ValueTransformera"},{"kind":"text","text":", "},{"kind":"externalParam","text":"transformTo"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ValueTransformer","preciseIdentifier":"s:10GLibObject16ValueTransformera"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"BindingRef","preciseIdentifier":"s:10GLibObject10BindingRefV"},{"kind":"text","text":"!"}],"abstract":[{"type":"text","text":"Bind a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SizeGroupPropertyName"},{"type":"text","text":" source property to a given target object."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SizeGroupProtocol\/bind(property:to:_:flags:transformFrom:transformTo:)","kind":"symbol","type":"topic","url":"\/documentation\/gtk\/sizegroupprotocol\/bind(property:to:_:flags:transformfrom:transformto:)"},"doc://Gtk/10GLibObject0B8ProtocolP":{"type":"unresolvable","title":"GLibObject.ObjectProtocol","identifier":"doc:\/\/Gtk\/10GLibObject0B8ProtocolP"},"#method@Gtk.SizeGroup.set_mode":{"title":"mode","titleInlineContent":[{"type":"text","text":"mode"}],"type":"link","identifier":"#method@Gtk.SizeGroup.set_mode","url":"#method@Gtk.SizeGroup.set_mode"},"doc://Gtk/documentation/Gtk/Box":{"role":"symbol","title":"Box","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Box"}],"abstract":[{"type":"text","text":"Arranges child widgets into a single row or column."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/Box","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Box"}],"url":"\/documentation\/gtk\/box"},"doc://Gtk/documentation/Gtk/SizeGroupProtocol/widgets":{"role":"symbol","title":"widgets","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"widgets"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"RefSListRef","preciseIdentifier":"s:4GLib08RefSListB0V"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"WidgetRef","preciseIdentifier":"s:3Gtk9WidgetRefV"},{"kind":"text","text":">!"}],"abstract":[{"type":"text","text":"Returns the list of widgets associated with "},{"type":"codeVoice","code":"sizeGroup"},{"type":"text","text":"."}],"identifier":"doc:\/\/Gtk\/documentation\/Gtk\/SizeGroupProtocol\/widgets","