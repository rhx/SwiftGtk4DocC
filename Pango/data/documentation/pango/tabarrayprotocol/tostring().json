{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toString"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"!"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the resulting string, serialized tabs are separated by newlines or commas."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Individual tabs are serialized to a string of the form"}]},{"type":"codeListing","syntax":null,"code":["[ALIGNMENT:]POSITION[:DECIMAL_POINT]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where ALIGNMENT is one of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"left"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"right"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"center"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"decimal"}]},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"POSITION is the position of the tab, optionally followed by the unit "},{"type":"emphasis","inlineContent":[{"type":"text","text":"px"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If ALIGNMENT is omitted, it defaults to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"left"}]},{"type":"text","text":". If ALIGNMENT is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"decimal"}]},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the DECIMAL_POINT character may be specified as a Unicode codepoint."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that all tabs in the array must use the same unit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical example:"}]},{"type":"codeListing","syntax":null,"code":["100px 200px center:300px right:400px"]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/pango\/tabarrayprotocol\/tostring()"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Pango\/documentation\/Pango\/TabArrayProtocol\/toString()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Serializes a "},{"type":"codeVoice","code":"PangoTabArray"},{"type":"text","text":" to a string."}],"kind":"symbol","metadata":{"role":"symbol","title":"toString()","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toString"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"!"}],"symbolKind":"method","externalID":"s:5Pango16TabArrayProtocolPAAE8toStringSSSgyF","extendedModule":"Pango","modules":[{"name":"Pango"}]},"hierarchy":{"paths":[["doc:\/\/Pango\/documentation\/Pango","doc:\/\/Pango\/documentation\/Pango\/TabArrayProtocol"]]},"references":{"doc://Pango/documentation/Pango":{"role":"collection","title":"Pango","abstract":[],"identifier":"doc:\/\/Pango\/documentation\/Pango","kind":"symbol","type":"topic","url":"\/documentation\/pango"},"doc://Pango/documentation/Pango/TabArrayProtocol":{"role":"symbol","title":"TabArrayProtocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TabArrayProtocol"}],"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"PangoTabArray"},{"type":"text","text":" contains an array of tab stops."}],"identifier":"doc:\/\/Pango\/documentation\/Pango\/TabArrayProtocol","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TabArrayProtocol"}],"url":"\/documentation\/pango\/tabarrayprotocol"},"doc://Pango/documentation/Pango/TabArrayProtocol/toString()":{"role":"symbol","title":"toString()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toString"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"!"}],"abstract":[{"type":"text","text":"Serializes a "},{"type":"codeVoice","code":"PangoTabArray"},{"type":"text","text":" to a string."}],"identifier":"doc:\/\/Pango\/documentation\/Pango\/TabArrayProtocol\/toString()","kind":"symbol","type":"topic","url":"\/documentation\/pango\/tabarrayprotocol\/tostring()"}}}