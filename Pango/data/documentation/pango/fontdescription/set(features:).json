{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"features"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"CChar","preciseIdentifier":"s:s5CChara"},{"kind":"text","text":">? = nil)"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"OpenType font features allow to enable or disable certain optional"},{"type":"text","text":" "},{"type":"text","text":"features of a font, such as tabular numbers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The format of the features string is comma-separated list of"},{"type":"text","text":" "},{"type":"text","text":"feature assignments, with each assignment being one of these forms:"}]},{"type":"codeListing","syntax":null,"code":["FEATURE=n"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"where FEATURE must be a 4 character tag that identifies and OpenType"},{"type":"text","text":" "},{"type":"text","text":"feature, and n an integer (depending on the feature, the allowed"},{"type":"text","text":" "},{"type":"text","text":"values may be 0, 1 or bigger numbers). Unknown features are ignored."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that font features set in this way are enabled for the entire text"},{"type":"text","text":" "},{"type":"text","text":"that is using the font, which is not appropriate for all OpenType features."},{"type":"text","text":" "},{"type":"text","text":"The intended use case is to select character variations (features cv01 - c99),"},{"type":"text","text":" "},{"type":"text","text":"style sets (ss01 - ss20) and the like."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pango does not currently have a way to find supported OpenType features"},{"type":"text","text":" "},{"type":"text","text":"of a font. Both harfbuzz and freetype have API for this. See for example"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"https:\/\/harfbuzz.github.io\/harfbuzz-hb-ot-layout.html#hb-ot-layout-table-get-feature-tags"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Features that are not supported by the font are silently ignored."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/pango\/fontdescription\/set(features:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Pango\/documentation\/Pango\/FontDescription\/set(features:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Sets the features field of a font description."}],"kind":"symbol","metadata":{"role":"symbol","title":"set(features:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"features"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"CChar","preciseIdentifier":"s:s5CChara"},{"kind":"text","text":">?)"}],"symbolKind":"method","externalID":"s:5Pango23FontDescriptionProtocolPAAE3set8featuresySPys4Int8VGSg_tF::SYNTHESIZED::s:5Pango15FontDescriptionC","extendedModule":"Pango","modules":[{"name":"Pango"}]},"hierarchy":{"paths":[["doc:\/\/Pango\/documentation\/Pango","doc:\/\/Pango\/documentation\/Pango\/FontDescription","doc:\/\/Pango\/documentation\/Pango\/FontDescription\/FontDescriptionProtocol-Implementations"]]},"references":{"https://harfbuzz.github.io/harfbuzz-hb-ot-layout.html