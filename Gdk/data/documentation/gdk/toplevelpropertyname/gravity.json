{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"gravity"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Gravity describes which point of the surface we want to keep"},{"type":"text","text":" "},{"type":"text","text":"fixed (meaning that the surface will grow in the opposite direction)."},{"type":"text","text":" "},{"type":"text","text":"For example, a gravity of "},{"type":"codeVoice","code":"GDK_GRAVITY_NORTH_EAST"},{"type":"text","text":" means that we"},{"type":"text","text":" "},{"type":"text","text":"want to fix top right corner of the surface."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This property is just a hint that may affect the result when negotiating"},{"type":"text","text":" "},{"type":"text","text":"toplevel sizes with the windowing system. It does not affect interactive"},{"type":"text","text":" "},{"type":"text","text":"resizes started with [method"},{"type":"codeVoice","code":"Gdk.Toplevel.begin_resize"},{"type":"text","text":"]."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gdk\/toplevelpropertyname\/gravity"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gdk\/documentation\/Gdk\/ToplevelPropertyName\/gravity","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The gravity to use when resizing a surface programmatically."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"gravity"}],"title":"ToplevelPropertyName.gravity","roleHeading":"Case","role":"symbol","symbolKind":"case","externalID":"s:3Gdk20ToplevelPropertyNameO7gravityyA2CmF","modules":[{"name":"Gdk"}]},"hierarchy"