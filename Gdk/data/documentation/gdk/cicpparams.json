"text","text":"parameters, or just to obtain information about the color state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gdk\/documentation\/Gdk\/CicpParams"},{"type":"text","text":" type acts as a reference-counted owner of an underlying "},{"type":"codeVoice","code":"GdkCicpParams"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It provides the methods that can operate on this data type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gdk\/documentation\/Gdk\/CicpParamsProtocol"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gdk\/documentation\/Gdk\/CicpParams"},{"type":"text","text":" as a strong reference or owner of a "},{"type":"codeVoice","code":"GdkCicpParams"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gdk\/documentation\/Gdk\/CicpParamsRef"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gdk\/documentation\/Gdk\/CicpParams"},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GdkCicpParams"},{"type":"text","text":" instance."}]}],"type":"aside","name":"Note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gdk\/cicpparams"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/Gdk\/10GLibObject0B0C"],"kind":"relationships","title":"Inherits From","type":"inheritsFrom"},{"identifiers":["doc:\/\/Gdk\/documentation\/Gdk\/CicpParamsProtocol","doc:\/\/Gdk\/4GLib14PointerWrapperP","doc:\/\/Gdk\/10GLibObject0B8ProtocolP"],"kind":"relationships","title":"Conforms To","type