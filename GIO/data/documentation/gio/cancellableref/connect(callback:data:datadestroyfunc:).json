{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connect"},{"kind":"text","text":"("},{"kind":"externalParam","text":"callback"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GCallback","preciseIdentifier":"c:gclosure.h@T@GCallback"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"data"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gpointer","preciseIdentifier":"c:gtypes.h@T@gpointer"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"dataDestroyFunc"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GDestroyNotify","preciseIdentifier":"c:gtypes.h@T@GDestroyNotify"},{"kind":"text","text":"? = nil) -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"callback"},{"type":"text","text":" is called exactly once each time "},{"type":"codeVoice","code":"cancellable"},{"type":"text","text":" is cancelled,"},{"type":"text","text":" "},{"type":"text","text":"either directly at the time of the connect if "},{"type":"codeVoice","code":"cancellable"},{"type":"text","text":" is already"},{"type":"text","text":" "},{"type":"text","text":"cancelled, or when "},{"type":"codeVoice","code":"cancellable"},{"type":"text","text":" is cancelled in some thread."},{"type":"text","text":" "},{"type":"text","text":"In case the cancellable is reset via [method"},{"type":"codeVoice","code":"Gio.Cancellable.reset"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"then the callback can be called again if the "},{"type":"codeVoice","code":"cancellable"},{"type":"text","text":" is cancelled and"},{"type":"text","text":" "},{"type":"text","text":"if it had not been previously cancelled at the time"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gio.Cancellable.connect"},{"type":"text","text":"] was called (e.g. if the connection actually"},{"type":"text","text":" "},{"type":"text","text":"took place, returning a non-zero value)."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dataDestroyFunc"},{"type":"text","text":" will be called when the handler is"},{"type":"text","text":" "},{"type":"text","text":"disconnected, or immediately if the cancellable is already"},{"type":"text","text":" "},{"type":"text","text":"cancelled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See [Cancellable](\/\/documentation\/gio\/cancellable\/oncancelled(flags:handler:) for details on how to use this."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since GLib 2.40, the lock protecting "},{"type":"codeVoice","code":"cancellable"},{"type":"text","text":" is not held when"},{"type":"text","text":" "},{"type":"codeVoice","code":"callback"},{"type":"text","text":" is invoked. This lifts a restriction in place for"},{"type":"text","text":" "},{"type":"text","text":"earlier GLib versions which now makes it easier to write cleanup"},{"type":"text","text":" "},{"type":"text","text":"code that unconditionally invokes e.g. [method"},{"type":"codeVoice","code":"Gio.Cancellable.cancel"},{"type":"text","text":"]."},{"type":"text","text":" "},{"type":"text","text":"Note that since 2.82 GLib still holds a lock during the callback but it’s"},{"type":"text","text":" "},{"type":"text","text":"designed in a way that most of the [class"},{"type":"reference","isActive":true,"identifier":"doc:\/\/GIO\/documentation\/GIO\/Cancellable"},{"type":"text","text":"] methods can be"},{"type":"text","text":" "},{"type":"text","text":"called, including [method"},{"type":"codeVoice","code":"Gio.Cancellable.cancel"},{"type":"text","text":"] or"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"GObject.Object.unref"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are still some methods that will deadlock (by design) when"},{"type":"text","text":" "},{"type":"text","text":"called from the [signal[Cancellable](\/\/documentation\/gio\/cancellable\/oncancelled(flags:handler:)] callbacks:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gio.Cancellable.connect"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gio.Cancellable.disconnect"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gio.Cancellable.reset"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gio.Cancellable.make_pollfd"},{"type":"text","text":"]"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gio.Cancellable.release_fd"},{"type":"text","text":"]"}]}]}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gio\/cancellableref\/connect(callback:data:datadestroyfunc:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/GIO\/documentation\/GIO\/CancellableRef\/connect(callback:data:dataDestroyFunc:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Convenience function to connect to the [Cancellable](\/\/documentation\/gio\/cancellable\/oncancelled(flags:handler:)"},{"type":"text","text":" "},{"type":"text","text":"signal. Also handles the race condition that may happen"},{"type":"text","text":" "},{"type":"text","text":"if the cancellable is cancelled right before connecting."}],"kind":"symbol","metadata":{"role":"symbol","title":"connect(callback:data:dataDestroyFunc:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connect"},{"kind":"text","text":"("},{"kind":"externalParam","text":"callback"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GCallback","preciseIdentifier":"c:gclosure.h@T@GCallback"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"data"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gpointer","preciseIdentifier":"c:gtypes.h@T@gpointer"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dataDestroyFunc"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GDestroyNotify","preciseIdentifier":"c:gtypes.h@T@GDestroyNotify"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"symbolKind":"method","externalID":"s:3GIO19CancellableProtocolPAAE7connect8callback4data0F11DestroyFuncSiyyXCSg_SvSgyAIXCSgtF::SYNTHESIZED::s:3GIO14CancellableRefV","extendedModule":"GIO","modules":[{"name":"GIO"}]},"hierarchy":{"paths":[["doc:\/\/GIO\/documentation\/GIO","doc:\/\/GIO\/documentation\/GIO\/CancellableRef","doc:\/\/GIO\/documentation\/GIO\/CancellableRef\/CancellableProtocol-Implementations"]]},"references":{"doc://GIO/documentation/GIO/CancellableRef/connect(callback:data:dataDestroyFunc:)":{"role":"symbol","title":"connect(callback:data:dataDestroyFunc:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"connect"},{"kind":"text","text":"("},{"kind":"externalParam","text":"callback"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GCallback","preciseIdentifier":"c:gclosure.h@T@GCallback"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"data"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gpointer","preciseIdentifier":"c:gtypes.h@T@gpointer"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"dataDestroyFunc"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GDestroyNotify","preciseIdentifier":"c:gtypes.h@T@GDestroyNotify"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"abstract":[{"type":"text","text":"Convenience function to connect to the [Cancellable](\/\/documentation\/gio\/cancellable\/oncancelled(flags:handler:)"},{"type":"text","text":" "},{"type":"text","text":"signal. Also handles the race condition that may happen"},{"type":"text","text":" "},{"type":"text","text":"if the cancellable is cancelled right before connecting."}],"identifier":"doc:\/\/GIO\/documentation\/GIO\/CancellableRef\/connect(callback:data:dataDestroyFunc:)","kind":"symbol","type":"topic","url":"\/documentation\/gio\/cancellableref\/connect(callback:data:datadestroyfunc:)"},"doc://GIO/documentation/GIO/CancellableRef":{"role":"symbol","title":"CancellableRef","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CancellableRef"}],"abstract":[{"type":"codeVoice","code":"GCancellable"},{"type":"text","text":" allows operations to be cancelled."}],"identifier":"doc:\/\/GIO\/documentation\/GIO\/CancellableRef","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"CancellableRef"}],"url":"\/documentation\/gio\/cancellableref"},"doc://GIO/documentation/GIO":{"role":"collection","title":"GIO","abstract":[],"identifier":"doc:\/\/GIO\/documentation\/GIO","kind":"symbol","type":"topic","url":"\/documentation\/gio"},"doc://GIO/documentation/GIO/Cancellable":{"role":"symbol","title":"Cancellable","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Cancellable"}],"abstract":[{"type":"codeVoice","code":"GCancellable"},{"type":"text","text":" allows operations to be cancelled."}],"identifier":"doc:\/\/GIO\/documentation\/GIO\/Cancellable","kind":"symbol","