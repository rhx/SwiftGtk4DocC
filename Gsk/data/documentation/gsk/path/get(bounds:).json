{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"get"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"GrapheneRectT"},{"kind":"text","text":">("},{"kind":"externalParam","text":"bounds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GrapheneRectT"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"GrapheneRectT"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"RectProtocol","preciseIdentifier":"s:8Graphene12RectProtocolP"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The returned bounds may be larger than necessary, because this"},{"type":"text","text":" "},{"type":"text","text":"function aims to be fast, not accurate. The bounds are guaranteed"},{"type":"text","text":" "},{"type":"text","text":"to contain the path."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible that the returned rectangle has 0 width and\/or height."},{"type":"text","text":" "},{"type":"text","text":"This can happen when the path only describes a point or an"},{"type":"text","text":" "},{"type":"text","text":"axis-aligned line."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the path is empty, "},{"type":"codeVoice","code":"FALSE"},{"type":"text","text":" is returned and "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":" are set to"},{"type":"text","text":" "},{"type":"codeVoice","code":"graphene_rect_zero()"},{"type":"text","text":". This is different from the case where the path"},{"type":"text","text":" "},{"type":"text","text":"is a single point at the origin, where the "},{"type":"codeVoice","code":"bounds"},{"type":"text","text":" will also be set to"},{"type":"text","text":" "},{"type":"text","text":"the zero rectangle but "},{"type":"codeVoice","code":"TRUE"},{"type":"text","text":" will be returned."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gsk\/path\/get(bounds:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gsk\/documentation\/Gsk\/Path\/get(bounds:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Computes the bounds of the given path."}],"kind":"symbol","metadata":{"role":"symbol","title":"get(bounds:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"get"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"GrapheneRectT"},{"kind":"text","text":">("},{"kind":"externalParam","text":"bounds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GrapheneRectT"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"symbolKind":"method","externalID":"s:3Gsk12PathProtocolPAAE3get6boundsSbqd___t8Graphene04RectC0Rd__lF::SYNTHESIZED::s:3Gsk4PathC","extendedModule":"Gsk","modules":[{"name":"Gsk"}]},"hierarchy":{"paths":[["doc:\/\/Gsk\/documentation\/Gsk","doc:\/\/Gsk\/documentation\/Gsk\/Path","doc:\/\/Gsk\/documentation\/Gsk\/Path\/PathProtocol-Implementations"]]},"references":{"doc://Gsk/documentation/Gsk/Path":{"role":"symbol","title":"Path","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Path"}],"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"GskPath"},{"type":"text","text":" describes lines and curves that are more complex"},{"type":"text","text":" "},{"type":"text","text":"than simple rectangles."}],"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/Path","kind":"symbol","type":