nt "},{"type":"codeVoice","code":"(x1, y1)"},{"type":"text","text":" and weight "},{"type":"codeVoice","code":"w"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All the commands have lowercase variants that interpret coordinates"},{"type":"text","text":" "},{"type":"text","text":"relative to the current point."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"O"},{"type":"text","text":" command is an extension that is not supported in SVG."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gsk\/path\/parse(string:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gsk\/documentation\/Gsk\/Path\/parse(string:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"This is a convenience function that constructs a "},{"type":"codeVoice","code":"GskPath"},{"type":"text","text":" "},{"type":"text","text":"from a serialized form."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"parse"},{"kind":"text","text":"("},{"kind":"externalParam","text":"string"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"CChar","preciseIdentifier":"s:s5CChara"},{"kind":"text","text":">!) -> "},{"kind":"typeIdentifier","text":"Path","preciseIdentifier":"s:3Gsk4PathC"},{"kind":"text","text":"!"}],"title":"parse(string:)","roleHeading":"Type Method","role":"symbol","symbolKind":"method","externalID":"s:3Gsk4PathC5parse6stringACSgSPys4Int8VGSg_tFZ","modules":[{"name":"Gsk"}]},"hierarchy":{"paths":[["doc:\/\/Gsk\/documentation\/Gsk","doc:\/\/Gsk\/documentation\/Gsk\/Path"]]},"references":{"doc://Gsk/documentation/Gsk/Path/parse(string:)":{"role":"symbol","t