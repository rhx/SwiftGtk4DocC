{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PathBuilderRef"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A path is constructed like this:"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"(C Language Example):"}]},{"type":"codeListing","syntax":"C","code":["GskPath *","construct_path (void)","{","  GskPathBuilder *builder;","","  builder = gsk_path_builder_new ();","","  \/\/ add contours to the path here","","  return gsk_path_builder_free_to_path (builder);"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Adding contours to the path can be done in two ways."},{"type":"text","text":" "},{"type":"text","text":"The easiest option is to use the "},{"type":"codeVoice","code":"gsk_path_builder_add_*"},{"type":"text","text":" group"},{"type":"text","text":" "},{"type":"text","text":"of functions that add predefined contours to the current path,"},{"type":"text","text":" "},{"type":"text","text":"either common shapes like [method"},{"type":"codeVoice","code":"Gsk.PathBuilder.add_circle"},{"type":"text","text":"]"},{"type":"text","text":" "},{"type":"text","text":"or by adding from other paths like [method"},{"type":"codeVoice","code":"Gsk.PathBuilder.add_path"},{"type":"text","text":"]."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"gsk_path_builder_add_*"},{"type":"text","text":" methods always add complete contours,"},{"type":"text","text":" "},{"type":"text","text":"and do not use or modify the current point."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The other option is to define each line and curve manually with"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"gsk_path_builder_*_to"},{"type":"text","text":" group of functions. You start with"},{"type":"text","text":" "},{"type":"text","text":"a call to [method"},{"type":"codeVoice","code":"Gsk.PathBuilder.move_to"},{"type":"text","text":"] to set the starting point"},{"type":"text","text":" "},{"type":"text","text":"and then use multiple calls to any of the drawing functions to"},{"type":"text","text":" "},{"type":"text","text":"move the pen along the plane. Once you are done, you can call"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gsk.PathBuilder.close"},{"type":"text","text":"] to close the path by connecting it"},{"type":"text","text":" "},{"type":"text","text":"back with a line to the starting point."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is similar to how paths are drawn in Cairo."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that "},{"type":"codeVoice","code":"GskPathBuilder"},{"type":"text","text":" will reduce the degree of added Bézier"},{"type":"text","text":" "},{"type":"text","text":"curves as much as possible, to simplify rendering."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/PathBuilderRef"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"GskPathBuilder"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/PathBuilderProtocol"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/PathBuilderRef"},{"type":"text","text":" only as an "},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference to an existing "},{"type":"codeVoice","code":"GskPathBuilder"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/PathBuilder"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/PathBuilderRef"},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"type":"codeVoice","code":"GskPathBuilder"},{"type":"text","text":" instance."}]}],"type":"aside","name":"Note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gsk\/pathbuilderref"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/Gsk\/4GLib14PointerWrapperP","doc:\/\/Gsk\/documentation\/Gsk\/PathBuilderProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/Gsk\/documentation\/Gsk\/PathBuilderRef","interfaceLanguage":"swift"},"abstract":[{"type":"codeVoice","code":"GskPathBuilder"},{"type":"text","text":" is an auxiliary object for constructing"},{"type":"text","text":" "},{"type":"codeVoice","code":"GskPath"},{"type":"text","text":" objects."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PathBuilderRef"}],"title":"PathBuilderRef","roleHeading":"Structure","role":"symbol","symbolKind":"struct","externalID":"s:3Gsk14PathBuilderRefV","modules":[{"name":"Gsk"}],"navigatorTitle":[{"kind":"identifier","text":"PathBuilderRef"}]},"hierarchy":{"paths":[["doc:\/\/Gsk\/documentation\/Gsk"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Gsk\/documentation\/Gsk\/PathBuilderRef\/init()","doc:\/\/Gsk\/documentation\/Gsk\/PathBuilderRef\/init(_:)-3hja5","do