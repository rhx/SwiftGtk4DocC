{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"dash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"CFloat","preciseIdentifier":"s:s6CFloata"},{"kind":"text","text":">! = nil, "},{"kind":"externalParam","text":"nDash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A dash pattern is specified by an array of alternating non-negative"},{"type":"text","text":" "},{"type":"text","text":"values. Each value provides the length of alternate “on” and “off”"},{"type":"text","text":" "},{"type":"text","text":"portions of the stroke."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each “on” segment will have caps applied as if the segment were a"},{"type":"text","text":" "},{"type":"text","text":"separate contour. In particular, it is valid to use an “on” length"},{"type":"text","text":" "},{"type":"text","text":"of 0 with "},{"type":"codeVoice","code":"GSK_LINE_CAP_ROUND"},{"type":"text","text":" or "},{"type":"codeVoice","code":"GSK_LINE_CAP_SQUARE"},{"type":"text","text":" to draw dots"},{"type":"text","text":" "},{"type":"text","text":"or squares along a path."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"nDash"},{"type":"text","text":" is 0, if all elements in "},{"type":"codeVoice","code":"dash"},{"type":"text","text":" are 0, or if there are"},{"type":"text","text":" "},{"type":"text","text":"negative values in "},{"type":"codeVoice","code":"dash"},{"type":"text","text":", then dashing is disabled."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"nDash"},{"type":"text","text":" is 1, an alternating “on” and “off” pattern with the"},{"type":"text","text":" "},{"type":"text","text":"single dash length provided is assumed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"nDash"},{"type":"text","text":" is uneven, the dash array will be used with the first"},{"type":"text","text":" "},{"type":"text","text":"element in "},{"type":"codeVoice","code":"dash"},{"type":"text","text":" defining an “on” or “off” in alternating passes"},{"type":"text","text":" "},{"type":"text","text":"through the array."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can specify a starting offset into the dash with"},{"type":"text","text":" "},{"type":"text","text":"[method"},{"type":"codeVoice","code":"Gsk.Stroke.set_dash_offset"},{"type":"text","text":"]."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gsk\/strokeref\/set(dash:ndash:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gsk\/documentation\/Gsk\/StrokeRef\/set(dash:nDash:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Sets the dash pattern to use by this stroke."}],"kind":"symbol","metadata":{"role":"symbol","title":"set(dash:nDash:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"dash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"CFloat","preciseIdentifier":"s:s6CFloata"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"nDash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"symbolKind":"method","externalID":"s:3Gsk14StrokeProtocolPAAE3set4dash5nDashySPySfGSg_SitF::SYNTHESIZED::s:3Gsk9StrokeRefV","extendedModule":"Gsk","modules":[{"name":"Gsk"}]},"hierarchy":{"paths":[["doc:\/\/Gsk\/documentation\/Gsk","doc:\/\/Gsk\/documentation\/Gsk\/StrokeRef","doc:\/\/Gsk\/documentation\/Gsk\/StrokeRef\/StrokeProtocol-Implementations"]]},"references":{"doc://Gsk/documentation/Gsk":{"role":"collection","title":"Gsk","abstract":[],"identifier":"doc:\/\/Gsk\/documentation\/Gsk","kind":"symbol","type":"topic","url":"\/documentation\/gsk"},"doc://Gsk/documentation/Gsk/StrokeRef/StrokeProtocol-Implementations":{"role":"collectionGroup","title":"StrokeProtocol Implementations","abstract":[],"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/StrokeRef\/StrokeProtocol-Implementations","kind":"article","type":"topic","url":"\/documentation\/gsk\/strokeref\/strokeprotocol-implementations"},"doc://Gsk/documentation/Gsk/StrokeRef":{"role":"symbol","title":"StrokeRef","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"StrokeRef"}],"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"GskStroke"},{"type":"text","text":" struct collects the parameters that influence"},{"type":"text","text":" "},{"type":"text","text":"the operation of stroking a path."}],"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/StrokeRef","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"StrokeRef"}],"url":"\/documentation\/gsk\/strokeref"},"doc://Gsk/documentation/Gsk/StrokeRef/set(dash:nDash:)":{"role":"symbol","title":"set(dash:nDash:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"set"},{"kind":"text","text":"("},{"kind":"externalParam","text":"dash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnsafePointer","preciseIdentifier":"s:SP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"CFloat","preciseIdentifier":"s:s6CFloata"},{"kind":"text","text":">!, "},{"kind":"externalParam","text":"nDash"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Sets the dash pattern to use by this stroke."}],"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/StrokeRef\/set(dash:nDash:)","kind":"symbol","type":"topic","url":"\/documentation\/gsk\/strokeref\/set(dash:ndash:)"}}}