{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"FillRule"},{"kind":"text","text":" = "},{"kind":"typeIdentifier","text":"GskFillRule","preciseIdentifier":"c:@EA@GskFillRule"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Whether or not a point is included in the fill is determined by taking"},{"type":"text","text":" "},{"type":"text","text":"a ray from that point to infinity and looking at intersections with the"},{"type":"text","text":" "},{"type":"text","text":"path. The ray can be in any direction, as long as it doesn’t pass through"},{"type":"text","text":" "},{"type":"text","text":"the end point of a segment or have a tricky intersection such as"},{"type":"text","text":" "},{"type":"text","text":"intersecting tangent to the path."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"(Note that filling is not actually implemented in this way. This"},{"type":"text","text":" "},{"type":"text","text":"is just a description of the rule that is applied.)"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"New entries may be added in future versions."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gsk\/fillrule"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gsk\/documentation\/Gsk\/FillRule","interfaceLanguage":"swift"},"abstract":[{"type":"codeVoice","code":"GskFillRule"},{"type":"text","text":" is used to select how paths are filled."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"FillRule"}],"title":"FillRule","roleHeading":"Type Alias","role":"symbol","symbolKind":"typealias","externalID":"s:3Gsk8FillRulea","modules":[{"name":"Gsk"}],"navigatorTitle":[{"kind":"identifier","text":"FillRule"}]},"hierarchy":{"paths":[["doc:\/\/Gsk\/documentation\/Gsk"]]},"references":{"doc://Gsk/documentation/Gsk/FillRule":{"role":"symbol","title":"FillRule","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"FillRule"}],"abstract":[{"type":"codeVoice","code":"GskFillRule"},{"type":"text","text":" is used to select how paths are filled."}],"identifier":"doc:\/\/Gsk\/documentation\/Gsk\/FillRule","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"FillRule"}],"url":"\/documentation\/gsk\/fillrule"},"doc://Gsk/documentation/Gsk":{"role":"collection","title":"Gsk","abstract":[],"identifier":"doc:\/\/Gsk\/documentation\/Gsk","kind":"symbol","type":"topic","url":"\/documentation\/gsk"}}}