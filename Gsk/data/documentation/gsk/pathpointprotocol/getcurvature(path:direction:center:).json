{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getCurvature"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"GraphenePointT"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"PathT"},{"kind":"text","text":">("},{"kind":"externalParam","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PathT"},{"kind":"text","text":", "},{"kind":"externalParam","text":"direction"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GskPathDirection","preciseIdentifier":"c:@EA@GskPathDirection"},{"kind":"text","text":", "},{"kind":"externalParam","text":"center"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"GraphenePointT"},{"kind":"text","text":"?) -> "},{"kind":"typeIdentifier","text":"CFloat","preciseIdentifier":"s:s6CFloata"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"GraphenePointT"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"PointProtocol","preciseIdentifier":"s:8Graphene13PointProtocolP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"PathT"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/Gsk\/documentation\/Gsk\/PathProtocol","preciseIdentifier":"s:3Gsk12PathProtocolP","text":"PathProtocol"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Optionally, returns the center of the osculating circle as well."},{"type":"text","text":" "},{"type":"text","text":"The curvature is the inverse of the radius of the osculating circle."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lines have a curvature of zero (indicating an osculating circle of"},{"type":"text","text":" "},{"type":"text","text":"infinite radius. In this case, the "},{"type":"codeVoice","code":"center"},{"type":"text","text":" is not modified."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Circles with a radius of zero have "},{"type":"codeVoice","code":"INFINITY"},{"type":"text","text":" as curvature"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that certain points on a path may not have a single curvature,"},{"type":"text","text":" "},{"type":"text","text":"such as sharp turns. At such points, there are two curvatures –"},{"type":"text","text":" "},{"type":"text","text":"the (limit of) the curvature of the path going into the point,"},{"type":"text","text":" "},{"type":"text","text":"and the (limit of) the curvature of the path coming out of it."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"direction"},{"type":"text","text":" argument lets you choose which one to get."}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/gsk\/pathpointprotocol\/getcurvature(path:direction:center:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Gsk\/documentation\/Gsk\/PathPointProtocol\/getCurvature(path:direction:center:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Calculates the curvature of the path at the point."}],"kind":"symbol","metadata":{"role":"symbol","title":"getCurvature(path:direction:center:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"getCurvature"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"GraphenePointT"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"PathT"},{"kind":"text","text":">("},{"kind":"externalParam","text":"path"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PathT"},{"kind":"text","text":", "},{"kind":"externalParam","text":"direction"},{"kind"