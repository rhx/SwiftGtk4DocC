{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextSelection"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The end object must appear after the start object in the accessibility tree,"},{"type":"text","text":" "},{"type":"text","text":"i.e. the end object must be reachable from the start object by navigating"},{"type":"text","text":" "},{"type":"text","text":"forward (next, first child etc)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This struct also contains a "},{"type":"codeVoice","code":"start_is_active"},{"type":"text","text":" boolean, to communicate if the"},{"type":"text","text":" "},{"type":"text","text":"start of the selection is the active point or not."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The active point corresponds to the user’s focus or point of interest. The"},{"type":"text","text":" "},{"type":"text","text":"user moves the active point to expand or collapse the range. The anchor"},{"type":"text","text":" "},{"type":"text","text":"point is the other point of the range and typically remains constant. In"},{"type":"text","text":" "},{"type":"text","text":"most cases, anchor is the start of the range and active is the end. However,"},{"type":"text","text":" "},{"type":"text","text":"when selecting backwards (e.g. pressing shift+left arrow in a text field),"},{"type":"text","text":" "},{"type":"text","text":"the start of the range is the active point, as the user moves this to"},{"type":"text","text":" "},{"type":"text","text":"manipulate the selection."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelection"},{"type":"text","text":" type acts as an owner of an underlying "},{"type":"codeVoice","code":"AtkTextSelection"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It provides the methods that can operate on this data type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelection"},{"type":"text","text":" as a strong reference or owner of a "},{"type":"codeVoice","code":"AtkTextSelection"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelection"},{"type":"text","text":") for a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"AtkTextSelection"},{"type":"text","text":" instance."}]}],"type":"aside","name":"Note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/atk\/textselection"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/Atk\/4GLib14PointerWrapperP","doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/Atk\/documentation\/Atk\/TextSelection","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"This structure represents a single  text selection within a document. This"},{"type":"text","text":" "},{"type":"text","text":"selection is defined by two points in the content, where each one is defined"},{"type":"text","text":" "},{"type":"text","text":"by an AtkObject supporting the AtkText interface and a character offset"},{"type":"text","text":" "},{"type":"text","text":"relative to it."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextSelection"}],"title":"TextSelection","roleHeading":"Class","role":"symbol","symbolKind":"class","externalID":"s:3Atk13TextSelectionC","modules":[{"name":"Atk"}],"navigatorTitle":[{"kind":"identifier","text":"TextSelection"}]},"hierarchy":{"paths":[["doc:\/\/Atk\/documentation\/Atk"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(_:)-1i06e","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(_:)-29xrb","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(_:)-2u1xr","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(_:)-5vt2h","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(_:)-7l6j3","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(cPointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(gconstpointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(gpointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(opaquePointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(raw:)-68dfo","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(raw:)-8uxmf","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(retaining:)","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(retainingCPointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(retainingOpaquePointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(retainingRaw:)-5cwe4","doc:\/\/Atk\/documentation\/Atk\/TextSelection\/init(retainingRaw:)-5o3h7"]},{"title":"Instance Properties","identifiers":["doc:\/\/Atk\/documentation\/Atk\/TextSelection\/ptr"]},{"title":"Default Implementations","identifiers":["doc:\/\/Atk\/documentation\/Atk\/TextSelection\/TextSelectionProtocol-Implementations"],"generated":true}],"references":