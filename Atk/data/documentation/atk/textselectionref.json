{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextSelectionRef"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The end object must appear after the start object in the accessibility tree,"},{"type":"text","text":" "},{"type":"text","text":"i.e. the end object must be reachable from the start object by navigating"},{"type":"text","text":" "},{"type":"text","text":"forward (next, first child etc)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This struct also contains a "},{"type":"codeVoice","code":"start_is_active"},{"type":"text","text":" boolean, to communicate if the"},{"type":"text","text":" "},{"type":"text","text":"start of the selection is the active point or not."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The active point corresponds to the user’s focus or point of interest. The"},{"type":"text","text":" "},{"type":"text","text":"user moves the active point to expand or collapse the range. The anchor"},{"type":"text","text":" "},{"type":"text","text":"point is the other point of the range and typically remains constant. In"},{"type":"text","text":" "},{"type":"text","text":"most cases, anchor is the start of the range and active is the end. However,"},{"type":"text","text":" "},{"type":"text","text":"when selecting backwards (e.g. pressing shift+left arrow in a text field),"},{"type":"text","text":" "},{"type":"text","text":"the start of the range is the active point, as the user moves this to"},{"type":"text","text":" "},{"type":"text","text":"manipulate the selection."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef"},{"type":"text","text":" type acts as a lightweight Swift reference to an underlying "},{"type":"codeVoice","code":"AtkTextSelection"},{"type":"text","text":" instance."},{"type":"text","text":" "},{"type":"text","text":"It exposes methods that can operate on this data type through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol"},{"type":"text","text":" conformance."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef"},{"type":"text","text":" only as an "},{"type":"codeVoice","code":"unowned"},{"type":"text","text":" reference to an existing "},{"type":"codeVoice","code":"AtkTextSelection"},{"type":"text","text":" instance."}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelection"},{"type":"text","text":" (instead of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef"},{"type":"text","text":") if you want to use Automatic Reference Counting for memory management of the underlying "},{"type":"codeVoice","code":"AtkTextSelection"},{"type":"text","text":" instance."}]}],"type":"aside","name":"Note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/atk\/textselectionref"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/Atk\/4GLib14PointerWrapperP","doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"identifier":{"url":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"This structure represents a single  text selection within a document. This"},{"type":"text","text":" "},{"type":"text","text":"selection is defined by two points in the content, where each one is defined"},{"type":"text","text":" "},{"type":"text","text":"by an AtkObject supporting the AtkText interface and a character offset"},{"type":"text","text":" "},{"type":"text","text":"relative to it."}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextSelectionRef"}],"title":"TextSelectionRef","roleHeading":"Structure","role":"symbol","symbolKind":"struct","externalID":"s:3Atk16TextSelectionRefV","modules":[{"name":"Atk"}],"navigatorTitle":[{"kind":"identifier","text":"TextSelectionRef"}]},"hierarchy":{"paths":[["doc:\/\/Atk\/documentation\/Atk"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(_:)-3jfag","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(_:)-5aqua","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(_:)-5i5f7","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(_:)-9f5ay","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(_:)-y44d","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(cPointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(constPointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(gconstpointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(gpointer:)","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(mutating:)","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/init(opaquePointer:)"]},{"title":"Instance Properties","identifiers":["doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/ptr"]},{"title":"Default Implementations","identifiers":["doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/PointerWrapper-Implementations","doc:\/\/Atk\/documentation\/Atk\/TextSelectionRef\/TextSelectionProtocol-Implementations"],"generated":true}],"references":{"doc://Atk/documentation/Atk/TextSelectionRef/init(cPointer:)":{"role":"symbol","title":"init(cPo