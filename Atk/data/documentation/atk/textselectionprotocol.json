stract":[{"type":"text","text":"the AtkText containing the end of the selection."}],"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol\/endObject","kind":"symbol","type":"topic","url":"\/documentation\/atk\/textselectionprotocol\/endobject"},"doc://Atk/documentation/Atk/TextSelectionProtocol/startIsActive":{"role":"symbol","title":"startIsActive","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"startIsActive"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gboolean","preciseIdentifier":"c:gtypes.h@T@gboolean"}],"abstract":[{"type":"text","text":"a gboolean indicating whether the start of the selection"},{"type":"text","text":" "},{"type":"text","text":"is the active point."}],"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol\/startIsActive","kind":"symbol","type":"topic","url":"\/documentation\/atk\/textselectionprotocol\/startisactive"},"doc://Atk/documentation/Atk/TextSelectionProtocol/startOffset":{"role":"symbol","title":"startOffset","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"startOffset"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gint","preciseIdentifier":"c:gtypes.h@T@gint"}],"abstract":[{"type":"text","text":"the text offset of the beginning of the selection within"},{"type":"text","text":" "},{"type":"codeVoice","code":"start_object"},{"type":"text","text":"."}],"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol\/startOffset","kind":"symbol","type":"topic","url":"\/documentation\/atk\/textselectionprotocol\/startoffset"},"doc://Atk/documentation/Atk/TextSelectionProtocol":{"role":"symbol","title":"TextSelectionProtocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextSelectionProtocol"}],"abstract":[{"type":"text","text":"This structure represents a single  text selection within a document. This"},{"type":"text","text":" "},{"type":"text","text":"selection is defined by two points in the content, where each one is defined"},{"type":"text","text":" "},{"type":"text","text":"by an AtkObject supporting the AtkText interface and a character offset"},{"type":"text","text":" "},{"type":"text","text":"relative to it."}],"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TextSelectionProtocol"}],"url":"\/documentation\/atk\/textselectionprotocol"},"doc://Atk/documentation/Atk/TextSelectionProtocol/endOffset":{"role":"symbol","title":"endOffset","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"endOffset"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"gint","preciseIdentifier":"c:gtypes.h@T@gint"}],"abstract":[{"type":"text","text":"the text offset of the end of the selection within "},{"type":"codeVoice","code":"end_object"},{"type":"text","text":"."}],"identifier":"doc:\/\/Atk\/documentation\/Atk\/TextSelectionProtocol\/endOffset","kind":"symbol","type":"topic","url":"\/documentation\/atk\/textselectionprotocol\/endoffset"}}}